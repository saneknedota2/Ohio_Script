searchBox:GetPropertyChangedSignal("Text"):Connect(function()
    customSearch = searchBox.Text:lower()
    if customSearch ~= "" then
        currentMode = "Search"
        for p, d in pairs(tracked) do d.hl:Destroy(); d.bb:Destroy(); tracked[p] = nil end
    end
end)

local espFolder = Instance.new("Folder", Workspace)

local function createVisual(part, color)
    if tracked[part] then return end
    local hl = Instance.new("Highlight")
    hl.FillColor = color
    hl.FillTransparency = 0.5
    hl.OutlineColor = color
    hl.Adornee = part
    hl.Parent = espFolder
    
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 200, 0, 20)
    bb.AlwaysOnTop = true
    bb.Adornee = part
    bb.Parent = espFolder
    
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = color
    lbl.Text = part.Name
    lbl.Parent = bb
    tracked[part] = {hl=hl, bb=bb}
end

-- Точный поиск (чтобы "ak" не находил "FakeGrass")
local function checkMatch(name, keywords)
    for _, k in ipairs(keywords) do
        if name == k or name:find(k) then 
            -- Игнорируем мусор
            if not name:find("fake") and not name:find("grass") and not name:find("glass") then
                return true 
            end
        end
    end
    return false
end

task.spawn(function()
    while task.wait(1.5) do
        if currentMode == "OFF" then
            for p, d in pairs(tracked) do d.hl:Destroy(); d.bb:Destroy(); tracked[p] = nil end
        else
            for part, data in pairs(tracked) do
                if not part.Parent then
                    data.hl:Destroy(); data.bb:Destroy(); tracked[part] = nil
                end
            end

            for _, obj in ipairs(Workspace:GetDescendants()) do
                if (obj:IsA("BasePart") or obj:IsA("Model")) and not tracked[obj] and obj ~= espFolder then
                    local n = obj.Name:lower()
                    
                    -- Игнорируем фейковые объекты
                    if not n:find("fake") and not n:find("grass") and not n:find("glass") then
                        if currentMode == "Search" and n:find(customSearch) then
                            createVisual(obj, COLORS.Custom)
                        elseif currentMode == "Weapon" and checkMatch(n, KEYWORDS.Weapon) then
                            createVisual(obj, COLORS.Weapon)
                        elseif currentMode == "Armor" and checkMatch(n, KEYWORDS.Armor) then
                            createVisual(obj, COLORS.Armor)
                        elseif currentMode == "Money" and checkMatch(n, KEYWORDS.Money) then
                            createVisual(obj, COLORS.Money)
                        elseif currentMode == "Food" and checkMatch(n, KEYWORDS.Food) then
                            createVisual(obj, COLORS.Food)
                        end
                    end
                end
            end
        end
    end
end)
