local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Точные настройки, чтобы не цеплять мусор
local KEYWORDS = {
    Weapon = { "gun", "weapon", "ak", "m4", "pistol", "shotgun", "knife", "glock", "rifle", "ammo", "paintball" },
    Armor  = { "armor", "vest", "helmet", "shield" },
    Money  = { "cash", "money", "dollar", "atm", "vault", "safe", "bank", "register", "cashier" },
    Food   = { "food", "medkit", "health", "heal", "apple", "burger", "water", "drink", "bandage" }
}

local COLORS = {
    Weapon = Color3.fromRGB(255, 50, 50),
    Armor  = Color3.fromRGB(50, 150, 255),
    Money  = Color3.fromRGB(255, 200, 0),
    Food   = Color3.fromRGB(0, 255, 150)
}

local currentMode = "OFF"
local autoFarm = false
local tracked = {}

-- GUI
local screenGui = Instance.new("ScreenGui")
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 220, 0, 380)
mainFrame.Position = UDim2.new(0, 20, 0, 60)
mainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
mainFrame.BorderSizePixel = 0
mainFrame.Parent = screenGui
Instance.new("UICorner", mainFrame).CornerRadius = UDim.new(0, 8)

local function createButton(text, mode, color, yPos)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 30)
    btn.Position = UDim2.new(0, 10, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 13
    btn.Parent = mainFrame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    
    btn.MouseButton1Click:Connect(function()
        if mode == "AutoFarm" then
            autoFarm = not autoFarm
            btn.BackgroundColor3 = autoFarm and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(30, 30, 40)
            btn.Text = autoFarm and "АВТО-ФАРМ: ВКЛ" or "Авто-Фарм денег"
        else
            currentMode = mode
            for p, d in pairs(tracked) do d.hl:Destroy(); d.bb:Destroy(); tracked[p] = nil end
            for _, child in ipairs(mainFrame:GetChildren()) do
                if child:IsA("TextButton") and child ~= btn and child.Text ~= "ВЫКЛЮЧИТЬ ВСЁ" and child.Text ~= "Авто-Фарм денег" and child.Text ~= "АВТО-ФАРМ: ВКЛ" then
                    child.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
                end
            end
            btn.BackgroundColor3 = color
        end
    end)
end

createButton("ВЫКЛЮЧИТЬ ВСЁ", "OFF", Color3.fromRGB(60,60,60), 10)
createButton("Оружие", "Weapon", COLORS.Weapon, 45)
createButton("Броня", "Armor", COLORS.Armor, 80)
createButton("Деньги / Сейфы", "Money", COLORS.Money, 115)
createButton("Еда", "Food", COLORS.Food, 150)
createButton("Авто-Фарм денег", "AutoFarm", Color3.fromRGB(0, 255, 100), 185)

local espFolder = Instance.new("Folder", Workspace)

local function createVisual(part, color)
    if tracked[part] then return end
    local hl = Instance.new("Highlight")
    hl.FillColor = color
    hl.FillTransparency = 0.5
    hl.OutlineColor = color
    hl.Adornee = part
    hl.Parent = espFolder
    
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 150, 0, 20)
    bb.AlwaysOnTop = true
    bb.Adornee = part
    bb.Parent = espFolder
    
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = color
    lbl.Text = part.Name
    lbl.Parent = bb
    tracked[part] = {hl=hl, bb=bb}
end

-- Умная проверка (ищет совпадение, но отсеивает мусор)
local function isUseful(name, keywords)
    local n = name:lower()
    if n:find("fake") or n:find("mesh") or n:find("part") or n:find("material") or n:find("glass") or n:find("grass") then return false end
    for _, k in ipairs(keywords) do
        if n:find(k) then return true end
    end
    return false
end

-- Логика Авто-Фарма
task.spawn(function()
    while task.wait(0.5) do
        if autoFarm and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = player.Character.HumanoidRootPart
            -- Ищем банкоматы, кассы и деньги
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("BasePart") or obj:IsA("Model") then
                    local n = obj.Name:lower()
                    if n:find("atm") or n:find("cash") or n:find("register") or n:find("vault") or n:find("safe") or n:find("money") then
                        local pos = obj:IsA("BasePart") and obj.Position or (obj.PrimaryPart and obj.PrimaryPart.Position)
                        if pos and (pos - hrp.Position).Magnitude < 15 then
                            -- Телепортируемся к объекту и активируем (ломаем/собираем)
                            if obj:FindFirstChild("ClickDetector") then
                                fireclickdetector(obj.ClickDetector)
                            elseif obj:FindFirstChildWhichIsA("ProximityPrompt") then
                                fireproximityprompt(obj:FindFirstChildWhichIsA("ProximityPrompt"))
                            end
                        end
                    end
                end
            end
        end
    end
end)

-- Отрисовка ESP
RunService.Heartbeat:Connect(function()
    if currentMode == "OFF" then return end
    
    for part, data in pairs(tracked) do
        if not part.Parent then
            data.hl:Destroy(); data.bb:Destroy(); tracked[part] = nil
        end
    end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if (obj:IsA("BasePart") or obj:IsA("Model")) and not tracked[obj] and obj ~= espFolder then
            if currentMode == "Weapon" and isUseful(obj.Name, KEYWORDS.Weapon) then createVisual(obj, COLORS.Weapon) end
            if currentMode == "Armor" and isUseful(obj.Name, KEYWORDS.Armor) then createVisual(obj, COLORS.Armor) end
            if currentMode == "Money" and isUseful(obj.Name, KEYWORDS.Money) then createVisual(obj, COLORS.Money) end
            if currentMode == "Food" and isUseful(obj.Name, KEYWORDS.Food) then createVisual(obj, COLORS.Food) end
        end
    end
end)
