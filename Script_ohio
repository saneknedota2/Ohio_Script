local function updateFovCircle()
    if not silentAimEnabled then
        fovCircle.Visible = false
        return
    end
    fovCircle.Visible = true
    -- Диаметр круга = радиус * 2
    fovCircle.Size = UDim2.new(0, fovRadius * 2, 0, fovRadius * 2)
end

-- Следим за камерой, чтобы круг всегда был в центре
RunService.RenderStepped:Connect(function()
    if silentAimEnabled then
        fovCircle.Position = UDim2.new(0.5, 0, 0.5, 0)
        updateFovCircle()
    end
end)

-- Логика наведения (Silent Aim)
local function getClosestPlayerInFov()
    local closestPlayer = nil
    local shortestDist = fovRadius
    local centerPos = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    
    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer ~= player and otherPlayer.Character then
            local head = otherPlayer.Character:FindFirstChild(targetPart)
            if head then
                -- Переводим 3D позицию в 2D экранную
                local screenPoint, onScreen = camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local screenPos = Vector2.new(screenPoint.X, screenPoint.Y)
                    local dist = (screenPos - centerPos).Magnitude
                    
                    if dist < shortestDist then
                        shortestDist = dist
                        closestPlayer = head
                    end
                end
            end
        end
    end
    return closestPlayer
end

-- Хук на клик мыши (когда стреляешь)
local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    -- Если скрипт пытается выстрелить
    if (method == 'Fire' or method == 'InvokeServer' or method == 'FindPartOnRay') and silentAimEnabled then
        if self:IsA("Tool") or tostring(self):find("Gun") then
            local target = getClosestPlayerInFov()
            if target then
                -- Подменяем цель на игрока в радиусе
                return oldNamecall(self, target, ...)
            end
        end
    end
    return oldNamecall(self, ...)
end)
setreadonly(mt, true)

