local function getClosestTarget()
    local closestPlayer = nil
    local shortestDist = fovRadius
    local centerPos = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local targetPart = p.Character:FindFirstChild(targetPartName) or p.Character:FindFirstChild("Head")
            if targetPart then
                local screenPos, onScreen = camera:WorldToViewportPoint(targetPart.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - centerPos).Magnitude
                    if dist < shortestDist then
                        if wallCheckEnabled then
                            local rayOrigin = camera.CFrame.Position
                            local rayDirection = (targetPart.Position - rayOrigin)
                            local raycastParams = RaycastParams.new()
                            raycastParams.FilterDescendantsInstances = {player.Character, p.Character}
                            raycastParams.FilterType = Enum.RaycastFilterType.Exclude
                            local rayResult = Workspace:Raycast(rayOrigin, rayDirection, raycastParams)
                            
                            if not rayResult then
                                shortestDist = dist
                                closestPlayer = targetPart
                            end
                        else
                            shortestDist = dist
                            closestPlayer = targetPart
                        end
                    end
                end
            end
        end
    end
    return closestPlayer
end

local lastShootTime = 0

RunService.RenderStepped:Connect(function()
    if aimbotEnabled or silentAimEnabled then
        fovCircle.Visible = true
        fovCircle.Size = UDim2.new(0, fovRadius * 2, 0, fovRadius * 2)
    else
        fovCircle.Visible = false
    end

    if aimbotEnabled then
        local target = getClosestTarget()
        if target then
            camera.CFrame = CFrame.new(camera.CFrame.Position, target.Position)
        end
    end

    if autoShootEnabled and player.Character then
        local tool = player.Character:FindFirstChildWhichIsA("Tool")
        if tool then
            local target = getClosestTarget()
            if target then
                if tick() - lastShootTime > 0.1 then
                    lastShootTime = tick()
                    pcall(function() tool:Activate() end)
                    pcall(function()
                        VirtualUser:CaptureController()
                        VirtualUser:ClickButton1(Vector2.new(0, 0))
                    end)
                end
            end
        end
    end
end)

