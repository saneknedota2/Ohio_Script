    Weapon = { "gun", "weapon", "ak47", "ak-47", "m4", "pistol", "shotgun", "knife", "glock", "rifle", "ammo" },
    Armor  = { "armor", "vest", "helmet", "shield" },
    Money  = { "cash", "money", "dollar", "atm", "vault", "safe", "bank" },
