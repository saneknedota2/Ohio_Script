-- АВТО-ВЗЛОМ СЕЙФОВ (ИСПРАВЛЕННЫЙ)
-- ==========================================
local function doSafeFarm()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local startPos = hrp.CFrame
    local safes = {}
    
    local parts = Workspace:GetPartBoundsInRadius(hrp.Position, 1000)
    local checked = {}

    for _, part in ipairs(parts) do
        local model = part.Parent
        if model and (model:IsA("Model") or model:IsA("BasePart")) and not checked[model] then
            local n = model.Name:lower()
            if n == "jewelsafe" or n == "goldjewelsafe" then
                local prompt = model:FindFirstChildWhichIsA("ProximityPrompt", true) or part:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt then
                    checked[model] = true
                    table.insert(safes, model)
                end
            end
        end
    end

    if #safes == 0 then return end

    for i, safe in ipairs(safes) do
        if not autoSafeFarm then break end

        local targetPart = safe.PrimaryPart or safe:FindFirstChildWhichIsA("BasePart") or safe:FindFirstChild("Hitbox")
        if targetPart then
            notify("Сейф " .. i .. ": Взлом")
            pcall(function() hrp.CFrame = CFrame.new(targetPart.Position + Vector3.new(0, 1, 2)) end)
            task.wait(0.3) 
            
            local prompt = safe:FindFirstChildWhichIsA("ProximityPrompt", true) or targetPart:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then
                pcall(function() fireproximityprompt(prompt) end)
                pcall(function()
                    VirtualUser:CaptureController()
                    VirtualUser:KeyDown(Enum.KeyCode.E)
                end)
            end
            
            task.wait(1) 
            pcall(function() VirtualUser:KeyUp(Enum.KeyCode.E) end)
            
            notify("Сейф " .. i .. ": Жду 1.5с...")
            task.wait(1.5) 
            
            notify("Сейф " .. i .. ": Сбор")
            local emptyPasses = 0
            
            while emptyPasses < 3 do
                if not autoSafeFarm then break end

                local lootParts = Workspace:GetPartBoundsInRadius(targetPart.Position, 30)
                local found = false
                
                for _, lootPart in ipairs(lootParts) do
                    local pName = lootPart.Name:lower()
                    local mName = lootPart.Parent and lootPart.Parent.Name:lower() or ""
                    
                    local character = lootPart.Parent
                    local isCharacter = false
                    if character then
                        if character:FindFirstChild("Humanoid") then isCharacter = true end
                        if character.Parent and character.Parent:FindFirstChild("Humanoid") then isCharacter = true end
                    end
                    
                    local isBodyPart = pName == "foot" or pName == "leg" or pName == "arm" or pName == "hand" or pName == "head" or pName == "torso" or pName == "leftfoot" or pName == "rightfoot"

                    local isJunk = pName:find("safe") or pName:find("main") or pName:find("door") or pName:find("hitbox") or pName:find("part") or 
                                   pName:find("atm") or pName:find("register") or pName:find("stand") or pName:find("counter") or
                                   pName:find("cash") or pName:find("money") or pName:find("dollar") or pName:find("bankcash") or
                                   pName:find("glass") or pName:find("display") or pName:find("case") or 
                                   mName:find("safe") or mName:find("cash") or mName:find("glass")
                    
                    if not isCharacter and not isBodyPart and not isJunk then
                        local isPickable = lootPart:IsA("Tool") or (lootPart.Parent and lootPart.Parent:IsA("Tool")) or
                                           lootPart:FindFirstChildWhichIsA("ClickDetector") or lootPart:FindFirstChildWhichIsA("ProximityPrompt") or
                                           (lootPart.Parent and (lootPart.Parent:FindFirstChildWhichIsA("ClickDetector") or lootPart.Parent:FindFirstChildWhichIsA("ProximityPrompt")))

                        if isPickable then
                            found = true
                            notify("Сбор: " .. pName)
                            pcall(function()
                                hrp.CFrame = CFrame.new(lootPart.Position)
                                task.wait(0.15)
                                
                                local lootPrompt = lootPart:FindFirstChildWhichIsA("ProximityPrompt", true) or (lootPart.Parent and lootPart.Parent:FindFirstChildWhichIsA("ProximityPrompt", true))
                                if lootPrompt then fireproximityprompt(lootPrompt) end
                                
                                local lootClick = lootPart:FindFirstChildWhichIsA("ClickDetector", true) or (lootPart.Parent and lootPart.Parent:FindFirstChildWhichIsA("ClickDetector", true))
                                if lootClick then fireclickdetector(lootClick) end
                                
                                if firetouchinterest then
                                    firetouchinterest(hrp, lootPart, 0)
                                    task.wait(0.05)
                                    firetouchinterest(hrp, lootPart, 1)
                                end
                            end)
                            break
                        end
                    end
                end
                
                if not found then emptyPasses = emptyPasses + 1 else emptyPasses = 0 end
                task.wait(0.2)
            end
        end
    end

    notify("Возврат на место...")
    task.wait(0.3)
    pcall(function() hrp.CFrame = startPos end)
    notify("Готово!")
end

task.spawn(function()
