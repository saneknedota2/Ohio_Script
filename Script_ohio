-- ЛОГИКА ФАРМА
task.spawn(function()
    while task.wait(0.3) do
        if (autoFarmBank or tpFarm) and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local closestObj = nil
                local shortestDist = tpFarm and 999999 or 20 -- Если ТП-фарм, ищем по всей карте

                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj:IsA("BasePart") or obj:IsA("Model") then
                        local n = obj.Name:lower()
                        if (n:find("atm") or n:find("register") or n:find("vault") or n:find("safe") or n:find("cash")) and not n:find("sign") then
                            local pos = obj:IsA("BasePart") and obj.Position or (obj.PrimaryPart and obj.PrimaryPart.Position)
                            if pos then
                                local dist = (pos - hrp.Position).Magnitude
                                if dist < shortestDist then
                                    shortestDist = dist
                                    closestObj = obj
                                end
                            end
                        end
                    end
                end

                if closestObj then
                    local pos = closestObj:IsA("BasePart") and closestObj.Position or (closestObj.PrimaryPart and closestObj.PrimaryPart.Position)
                    
                    -- Если это ТП-фарм и мы далеко, телепортируемся
                    if tpFarm and shortestDist > 5 then
                        hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
                        task.wait(0.2)
                    end
                    
                    -- Бьем, если мы близко
                    if (pos - hrp.Position).Magnitude < 10 then
                        attack()
                    end
                end
            end
        end
    end
end)

-- Отрисовка визуалов
task.spawn(function()
    while task.wait(1.5) do
        if currentMode == "OFF" then
            for p, d in pairs(tracked) do d.hl:Destroy(); d.bb:Destroy(); tracked[p] = nil end
        else
            for part, data in pairs(tracked) do
                if not part.Parent then
                    data.hl:Destroy(); data.bb:Destroy(); tracked[part] = nil
                end
            end

            for _, obj in ipairs(Workspace:GetDescendants()) do
                if (obj:IsA("BasePart") or obj:IsA("Model")) and not tracked[obj] and obj ~= espFolder then
                    if isItem(obj, currentMode) then
                        createVisual(obj, COLORS[currentMode])
                    end
                end
            end
        end
    end
end)
