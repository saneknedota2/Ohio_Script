local function createButton(text, mode, color, yPos)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 30)
    btn.Position = UDim2.new(0, 10, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 13
    btn.Parent = mainFrame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    
    btn.MouseButton1Click:Connect(function()
        currentMode = mode
        customSearch = ""
        searchBox.Text = ""
        for p, d in pairs(tracked) do d.hl:Destroy(); d.bb:Destroy(); tracked[p] = nil end
        
        for _, child in ipairs(mainFrame:GetChildren()) do
            if child:IsA("TextButton") and child.Text ~= "ВЫКЛЮЧИТЬ ВСЁ" then
                child.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
            end
        end
        btn.BackgroundColor3 = color
    end)
end

