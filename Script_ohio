                local targetObj = nil
                local shortestDist = 1000
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj:IsA("BasePart") or obj:IsA("Model") then
                        local n = obj.Name:lower()
                        if (n == "bankcash" or n == "cash" or n == "money" or n == "moneydrop") then
                            if not (n:find("register") or n:find("atm") or n:find("cashier") or n:find("shelf") or n:find("box") or n:find("safe") or n:find("vault") or n:find("tutorial")) then
                                local click = obj:FindFirstChildWhichIsA("ClickDetector", true)
                                local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                                if click or prompt then
                                    local pos = obj:IsA("BasePart") and obj.Position or (obj.PrimaryPart and obj.PrimaryPart.Position)
                                    if pos then
                                        local dist = (pos - hrp.Position).Magnitude
                                        if dist < shortestDist then shortestDist = dist; targetObj = obj end
                                    end
                                end
                            end
                        end
                    end
                end
                if targetObj then
                    local targetPos = targetObj:IsA("BasePart") and targetObj.Position or (targetObj.PrimaryPart and targetObj.PrimaryPart.Position)
                    if targetPos then
                        hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
                        task.wait(0.05) 
                        local prompt = targetObj:FindFirstChildWhichIsA("ProximityPrompt", true)
                        if prompt then pcall(function() fireproximityprompt(prompt) end) end
                        local click = targetObj:FindFirstChildWhichIsA("ClickDetector", true)
                        if click then pcall(function() fireclickdetector(click) end) end
                    end
                end
            end
        end
    end
end)

-- УЛЬТРА-БЫСТРЫЙ РАДАР ESP (GetPartBoundsInRadius)
task.spawn(function()
    while task.wait(1.5) do
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            -- Очистка старых
            for p, d in pairs(tracked) do
                if not p.Parent or (not espToggles[d.cat] and searchFilter == "") or (searchFilter ~= "" and not p.Name:lower():find(searchFilter)) then
                    d.hl:Destroy(); d.bb:Destroy(); tracked[p] = nil
                end
            end
            
            -- Магия оптимизации: сканируем только близлежащие объекты (радиус 250 метров)
            local partsInRadius = Workspace:GetPartBoundsInRadius(hrp.Position, 250)
            local checkedModels = {}
            
            for _, part in ipairs(partsInRadius) do
                local targetObj = part
                -- Если деталь лежит внутри Модели или Инструмента, проверяем их
                if part.Parent and (part.Parent:IsA("Tool") or part.Parent:IsA("Model")) then
                    targetObj = part.Parent
                end
                
                if not tracked[targetObj] and not checkedModels[targetObj] then
                    checkedModels[targetObj] = true
                    local n = targetObj.Name:lower()
                    
                    -- Блокируем мусор
                    if not (n:find("fake") or n:find("glass") or n:find("grass") or n:find("wall") or n:find("floor") or n:find("baseplate") or n:find("building") or n:find("sign") or n:find("mesh") or n:find("material") or n:find("tutorial")) then
                        
                        -- Проверяем, можно ли предмет взять (Drop)
                        local isPickable = targetObj:IsA("Tool") or targetObj:FindFirstChildWhichIsA("ClickDetector", true) or targetObj:FindFirstChildWhichIsA("ProximityPrompt", true)
                        
                        if searchFilter ~= "" then
                            if n:find(searchFilter) then createVisual(targetObj, Color3.fromRGB(255, 255, 255), "Search") end
                        else
                            for cat, isOn in pairs(espToggles) do
                                if isOn then
                                    -- ЛОГИКА "ПОДОБРАТЬ" (Только то, что можно взять)
                                    if cat == "DropWeapon" then
                                        if isPickable and (n:find("gun") or n:find("ak") or n:find("m4") or n:find("pistol") or n:find("shotgun") or n:find("rifle") or n:find("weapon")) then
                                            createVisual(targetObj, ESP_COLORS.DropWeapon, cat)
                                        end
                                    
                                    -- ЛОГИКА "КУПИТЬ" (Только то, что НЕЛЬЗЯ взять, но это пушка)
                                    elseif cat == "ShopWeapon" then
                                        if not isPickable and (n:find("gun") or n:find("ak") or n:find("m4") or n:find("pistol") or n:find("shotgun") or n:find("rifle")) then
                                            createVisual(targetObj, ESP_COLORS.ShopWeapon, cat)
                                        end
                                    
                                    -- КАРТОЧКИ (Только то, что можно взять)
                                    elseif cat == "BlueCard" then
                                        if isPickable and n:find("card") and n:find("blue") then createVisual(targetObj, ESP_COLORS.BlueCard, cat) end
                                    elseif cat == "RedCard" then
                                        if isPickable and n:find("card") and n:find("red") then createVisual(targetObj, ESP_COLORS.RedCard, cat) end
                                    elseif cat == "AllCards" then
                                        if isPickable and n:find("card") then createVisual(targetObj, ESP_COLORS.AllCards, cat) end
                                    
                                    -- ЕДА И БРОНЯ
                                    elseif cat == "Armor" then
                                        if isPickable and (n:find("armor") or n:find("vest") or n:find("helmet")) then createVisual(targetObj, ESP_COLORS.Armor, cat) end
                                    elseif cat == "Food" then
                                        if isPickable and (n:find("food") or n:find("medkit") or n:find("bandage") or n:find("apple") or n:find("burger")) then createVisual(targetObj, ESP_COLORS.Food, cat) end
                                    
                                    -- ДЕНЬГИ
                                    elseif cat == "Money" then
                                        if (n:find("atm") or n:find("vault") or n:find("safe") or n:find("bankcash") or n:find("cash") or n:find("money")) and not n:find("register") then
                                            createVisual(targetObj, ESP_COLORS.Money, cat)
