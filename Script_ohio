    local box = Instance.new("Frame")
    box.Size = UDim2.new(0, 50, 0, 70)
    box.Position = UDim2.new(0.5, -25, 0.5, -35)
    box.BackgroundTransparency = 1
    box.Parent = bb
    local stroke = Instance.new("UIStroke", box)
    stroke.Color = Color3.fromRGB(255, 0, 0)
    stroke.Thickness = 2

    local infoLabel = Instance.new("TextLabel")
    infoLabel.Size = UDim2.new(1, 0, 0, 30)
    infoLabel.Position = UDim2.new(0, 0, 0, -30)
    infoLabel.BackgroundTransparency = 1
    infoLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    infoLabel.TextStrokeTransparency = 0
    infoLabel.Font = Enum.Font.GothamBold
    infoLabel.TextSize = 12
    infoLabel.Text = "Загрузка..."
    infoLabel.Parent = bb

    trackedPlayers[otherPlayer] = {bb = bb, label = infoLabel, box = box}
end

RunService.Heartbeat:Connect(function()
    for p, data in pairs(trackedPlayers) do
        if not espToggles.PlayersESP then
            data.bb.Enabled = false
        else
            data.bb.Enabled = true
            local char = p.Character
            if char and data.label.Parent then
                local hum = char:FindFirstChild("Humanoid")
                local hp = hum and math.floor(hum.Health) or 0
                local shieldVal = char:FindFirstChild("Shield") or char:FindFirstChild("Armor") or char:FindFirstChild("MaxShield")
                local shield = shieldVal and math.floor(shieldVal.Value) or 0
                local tool = char:FindFirstChildWhichIsA("Tool")
                local toolName = tool and tool.Name or "Кулаки"
                
                data.label.Text = string.format("[%s]\nHP: %d | Щит: %d\nВ руках: %s", p.DisplayName, hp, shield, toolName)
                
                if hp < 30 then data.box.UIStroke.Color = Color3.fromRGB(255, 0, 0)
                elseif hp < 70 then data.box.UIStroke.Color = Color3.fromRGB(255, 150, 0)
                else data.box.UIStroke.Color = Color3.fromRGB(0, 255, 0) end
            end
        end
    end
end)

local function setupPlayer(p)
    if p ~= player then
        p.CharacterAdded:Connect(function()
            task.wait(1)
            createPlayerESP(p)
        end)
        if p.Character then createPlayerESP(p) end
    end
end

for _, p in ipairs(Players:GetPlayers()) do setupPlayer(p) end
Players.PlayerAdded:Connect(setupPlayer)
Players.PlayerRemoving:Connect(function(p)
    if trackedPlayers[p] then
        trackedPlayers[p].bb:Destroy()
        trackedPlayers[p] = nil
    end
end)
