task.spawn(function()
    while task.wait(0.2) do 
        if autoHealEnabled and player.Character and not isHealing then
            local char = player.Character
            local hum = char:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 and hum.Health < healThreshold then
                local backpack = player:FindFirstChild("Backpack")
                if backpack then
                    for _, item in ipairs(backpack:GetChildren()) do
                        if item:IsA("Tool") then
                            local n = item.Name:lower()
                            if n:find("аптеч") or n:find("повяз") or n:find("бинт") or n:find("med") then
                                isHealing = true
                                
                                -- Запоминаем текущее оружие
                                local currentTool = char:FindFirstChildWhichIsA("Tool")
                                
                                -- Принудительно берем аптечку в руки
                                pcall(function() hum:EquipTool(item) end)
                                task.wait(0.3) 
                                
                                -- Активируем
                                pcall(function() item:Activate() end)
                                
                                -- Ждем 2 секунды (анимация и восстановление)
                                task.wait(2) 
                                
                                -- Возвращаем оружие (если есть)
                                if currentTool and currentTool.Parent == backpack then
                                    pcall(function() hum:EquipTool(currentTool) end)
                                end
                                task.wait(0.1)
                                
                                -- Убираем аптечку обратно
                                if item.Parent == char then
                                    item.Parent = backpack
                                end
                                
                                isHealing = false
                                break
                            end
                        end
                    end
                end
            end
        end
    end
end)

