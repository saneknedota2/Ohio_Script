local espFolder = Instance.new("Folder", Workspace)

local function createVisual(obj, color, cat)
    if tracked[obj] then return end
    
    local hl = Instance.new("Highlight")
    hl.FillColor = color
    hl.FillTransparency = 0.5
    hl.OutlineColor = color
    hl.Adornee = obj
    hl.Parent = espFolder
    
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 150, 0, 20)
    bb.AlwaysOnTop = true
    bb.Adornee = obj
    bb.Parent = espFolder
    
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = color
    lbl.Text = obj.Name
    lbl.Parent = bb
    
    tracked[obj] = {hl=hl, bb=bb, cat=cat}
end

task.spawn(function()
    while task.wait(1.5) do
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            -- Очистка старых меток
            for p, d in pairs(tracked) do
                if not p.Parent or not espToggles[d.cat] then
                    d.hl:Destroy(); d.bb:Destroy(); tracked[p] = nil
                end
            end
            
            -- Быстрый радар (ищем только в радиусе 300 метров)
            local parts = Workspace:GetPartBoundsInRadius(hrp.Position, 300)
            local checked = {}
            
            for _, part in ipairs(parts) do
                local obj = part
                if part.Parent and (part.Parent:IsA("Model") or part.Parent:IsA("Tool")) then
                    obj = part.Parent
                end
                
                -- Не рисуем на игроках
                local isPlayer = Players:GetPlayerFromCharacter(obj) or (obj.Parent and Players:GetPlayerFromCharacter(obj.Parent))
                
                if not checked[obj] and not tracked[obj] and not isPlayer then
                    checked[obj] = true
                    local n = obj.Name:lower()
                    
                    -- Игнорируем мусор и комнаты
                    if not (n:find("fake") or n:find("glass") or n:find("wall") or n:find("floor") or n:find("room") or n:find("part") or n:find("hitbox") or n:find("baseplate")) then
                        
                        -- ОРУЖИЕ
                        if n:find("ak") or n:find("m4") or n:find("gun") or n:find("glock") or n:find("m1911") or n:find("deagle") or n:find("сайга") or n:find("пистолет") or n:find("оружие") then
                            local hasPrice = obj:FindFirstChild("Price") or obj:FindFirstChildWhichIsA("NumberValue") or (obj.Parent and obj.Parent:FindFirstChild("Price"))
                            if hasPrice then
                                if espToggles.ShopWeapon then createVisual(obj, ESP_COLORS.ShopWeapon, "ShopWeapon") end
                            else
                                if espToggles.DropWeapon then createVisual(obj, ESP_COLORS.DropWeapon, "DropWeapon") end
                            end
                        -- БРОНЯ
                        elseif n:find("жилет") or n:find("armor") or n:find("vest") then
                            if espToggles.Armor then createVisual(obj, ESP_COLORS.Armor, "Armor") end
                        -- ДЕНЬГИ
                        elseif n:find("atm") or n == "cash" or n == "money" or n:find("bankcash") then
                            if espToggles.Money then createVisual(obj, ESP_COLORS.Money, "Money") end
                        -- КАРТОЧКИ
                        elseif n:find("card") or n:find("key") then
                            if espToggles.AllCards then createVisual(obj, ESP_COLORS.AllCards, "AllCards") end
                        -- ЕДА
                        elseif n:find("food") or n:find("medkit") or n:find("bandage") then
                            if espToggles.Food then createVisual(obj, ESP_COLORS.Food, "Food") end
                        end
                    end
                end
            end
        end
    end
end)

-- ==========================================
-- АВТО-ФАРМ ДЕНЕГ (Плавный ТП)
-- ==========================================
task.spawn(function()
    while task.wait(0.5) do
        if autoFarmBank and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                -- Используем радар для поиска денег рядом
                local parts = Workspace:GetPartBoundsInRadius(hrp.Position, 150)
                local targetCash = nil
                local shortestDist = 150
                
                for _, part in ipairs(parts) do
                    local obj = part
                    if part.Parent and part.Parent:IsA("Model") then obj = part.Parent end
                    local n = obj.Name:lower()
                    
                    -- Ищем только купюры, игнорируя кассы и банкоматы
                    if (n == "cash" or n == "money" or n:find("bankcash") or n:find("moneydrop")) then
                        if not n:find("atm") and not n:find("register") and not n:find("safe") then
                            
                            local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                            local click = obj:FindFirstChildWhichIsA("ClickDetector", true)
                            
                            if prompt or click then
                                local pos = obj:IsA("BasePart") and obj.Position or (obj.PrimaryPart and obj.PrimaryPart.Position)
                                if pos then
                                    local dist = (pos - hrp.Position).Magnitude
                                    if dist < shortestDist then
                                        shortestDist = dist
                                        targetCash = obj
                                    end
                                end
                            end
                        end
                    end
                end

                -- Если нашли деньги, плавно летим к ним
                if targetCash then
                    local pos = targetCash:IsA("BasePart") and targetCash.Position or (targetCash.PrimaryPart and targetCash.PrimaryPart.Position)
                    if pos then
                        -- Плавный телепорт за 0.15 секунды (античит не замечает)
                        local tweenInfo = TweenInfo.new(0.15, Enum.EasingStyle.Linear)
                        local tween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))})
                        tween:Play()
                        tween.Completed:Wait()
                        
                        task.wait(0.05) -- Микро-пауза
                        
                        -- Собираем
                        local prompt = targetCash:FindFirstChildWhichIsA("ProximityPrompt", true)
                        if prompt then pcall(function() fireproximityprompt(prompt) end) end
                        local click = targetCash:FindFirstChildWhichIsA("ClickDetector", true)
                        if click then pcall(function() fireclickdetector(click) end) end
                    end
                end
            end
        end
    end
end)
