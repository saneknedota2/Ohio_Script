local espFolder = Instance.new("Folder", Workspace)

local function createVisual(part, color, category)
    if tracked[part] then return end
    local hl = Instance.new("Highlight"); hl.FillColor = color; hl.FillTransparency = 0.5; hl.OutlineColor = color; hl.Adornee = part; hl.Parent = espFolder
    local bb = Instance.new("BillboardGui"); bb.Size = UDim2.new(0, 150, 0, 20); bb.AlwaysOnTop = true; bb.Adornee = part; bb.Parent = espFolder
    local lbl = Instance.new("TextLabel"); lbl.Size = UDim2.new(1, 0, 1, 0); lbl.BackgroundTransparency = 1; lbl.TextColor3 = color; lbl.Text = string.sub(part.Name, 1, 15); lbl.Parent = bb
    tracked[part] = {hl=hl, bb=bb, cat=category}
end

task.spawn(function()
    while task.wait(2) do
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            for p, d in pairs(tracked) do
                if not p.Parent or not espToggles[d.cat] then
                    d.hl:Destroy(); d.bb:Destroy(); tracked[p] = nil
                end
            end
            
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if (obj:IsA("BasePart") or obj:IsA("Model")) and not tracked[obj] and obj ~= espFolder then
                    local isPlayer = Players:GetPlayerFromCharacter(obj) or (obj.Parent and Players:GetPlayerFromCharacter(obj.Parent))
                    if isPlayer then continue end
                    
                    local objPos = obj:IsA("BasePart") and obj.Position or (obj.PrimaryPart and obj.PrimaryPart.Position)
                    if objPos and (objPos - hrp.Position).Magnitude < 300 then
                        local n = obj.Name:lower()
                        if not (n:find("wall") or n:find("floor") or n:find("mesh") or n:find("door") or #obj.Name > 25) then
                            local isGun = n:find("gun") or n:find("ak47") or n:find("m4") or n:find("pistol") or n:find("deagle")
                            local isFood = n:find("food") or n:find("аптеч") or n:find("повяз") or n:find("medkit")
                            local isJewel = n:find("jewel") or n:find("gem") or n:find("diamond") or n:find("ring") or n:find("gold")

                            if espToggles.ShopWeapon and isGun and (obj:FindFirstChild("Price") or obj:FindFirstChildWhichIsA("NumberValue")) then
                                createVisual(obj, ESP_COLORS.ShopWeapon, "ShopWeapon")
                            elseif espToggles.DropWeapon and isGun and not (obj:FindFirstChild("Price")) then
                                createVisual(obj, ESP_COLORS.DropWeapon, "DropWeapon")
                            elseif espToggles.Food and isFood then
                                createVisual(obj, ESP_COLORS.Food, "Food")
                            elseif espToggles.Money and (n == "cash" or n == "money" or n:find("bankcash")) then
                                createVisual(obj, ESP_COLORS.Money, "Money")
                            elseif espToggles.Armor and (n:find("armor") or n:find("vest") or n:find("жилет")) then
                                createVisual(obj, ESP_COLORS.Armor, "Armor")
                            elseif espToggles.Jewel and isJewel then
                                createVisual(obj, ESP_COLORS.Jewel, "Jewel")
                            end
                        end
                    end
                end
            end
        end
    end
end)
