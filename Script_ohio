local espFolder = Instance.new("Folder", Workspace)

local function createVisual(part, color)
    if tracked[part] then return end
    local hl = Instance.new("Highlight")
    hl.FillColor = color
    hl.FillTransparency = 0.5
    hl.OutlineColor = color
    hl.Adornee = part
    hl.Parent = espFolder
    
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 150, 0, 20)
    bb.AlwaysOnTop = true
    bb.Adornee = part
    bb.Parent = espFolder
    
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = color
    lbl.Text = part.Name
    lbl.Parent = bb
    tracked[part] = {hl=hl, bb=bb}
end

local function checkWeapon(obj)
    local n = obj.Name:lower()
    if n:find("sign") or n:find("mesh") or n:find("material") or n:find("part") then return nil end
    local isGun = n:find("gun") or n:find("ak47") or n:find("m4") or n:find("pistol") or n:find("shotgun") or n:find("rifle")
    if not isGun then return nil end
    local hasPrice = obj:FindFirstChild("Price") or obj:FindFirstChild("Cost") or obj:FindFirstChildWhichIsA("NumberValue")
    local isPickable = obj:FindFirstChildWhichIsA("ClickDetector") or obj:FindFirstChildWhichIsA("ProximityPrompt")
    if hasPrice then return "ShopWeapon" elseif isPickable then return "DropWeapon" end
    return "ShopWeapon"
end

local function isItem(obj, category)
    local n = obj.Name:lower()
    if n:find("sign") or n:find("wall") or n:find("mesh") or n:find("part") or n:find("building") or n:find("mug") or n:find("cup") or n:find("tower") then return false end
    if category == "ShopWeapon" or category == "DropWeapon" then return checkWeapon(obj) == category
    elseif category == "Armor" then return (n:find("armor") or n:find("vest") or n:find("helmet")) and (obj:FindFirstChildWhichIsA("ClickDetector") or n:find("shop"))
    elseif category == "Money" then return (n:find("atm") or n:find("vault") or n:find("safe") or n:find("register") or n:find("cash")) and not n:find("sign")
    elseif category == "Food" then return (n:find("food") or n:find("medkit") or n:find("bandage") or n:find("apple") or n:find("burger") or n:find("water")) and (obj:FindFirstChildWhichIsA("ClickDetector") or n:find("shop")) end
    return false
end

-- Функция плавного телепорта (чтобы античит не ругался)
local function smoothTeleport(targetPos)
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local tweenInfo = TweenInfo.new(0.15, Enum.EasingStyle.Linear) 
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(targetPos + Vector3.new(0, 2, 0))})
    tween:Play()
end

-- УЛУЧШЕННЫЙ АВТО-ФАРМ (ТП ТОЛЬКО К ДЕНЬГАМ)
task.spawn(function()
    while task.wait(0.3) do
        if autoFarmBank and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local targetObj = nil
                local shortestDist = 50 -- Ищем деньги в радиусе 50 метров

                -- Ищем ТОЛЬКО выпавшие купюры. Игнорируем двери, дома и сейфы.
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj:IsA("BasePart") or obj:IsA("Model") then
                        local n = obj.Name:lower()
                        
                        -- Если это деньги
                        if (n == "cash" or n:find("cash") or n:find("money") or n == "dollar" or n:find("dollar")) then
                            -- И если это НЕ дверь, не дом и не стена
                            if not (n:find("door") or n:find("house") or n:find("wall") or n:find("sign") or n:find("building") or n:find("safe")) then
                                local pos = obj:IsA("BasePart") and obj.Position or (obj.PrimaryPart and obj.PrimaryPart.Position)
                                if pos then
                                    local dist = (pos - hrp.Position).Magnitude
                                    if dist < shortestDist then
                                        shortestDist = dist
                                        targetObj = obj
                                    end
                                end
                            end
                        end
                    end
                end

                -- Если нашли деньги — плавно летим к ним и собираем
                if targetObj then
                    local targetPos = targetObj:IsA("BasePart") and targetObj.Position or (targetObj.PrimaryPart and targetObj.PrimaryPart.Position)
                    
                    if targetPos then
                        -- Если мы далеко (больше 6 метров), делаем плавный ТП
                        if shortestDist > 6 then
                            smoothTeleport(targetPos)
                            task.wait(0.2) 
                        end
                        
                        -- Нажимаем, чтобы подобрать
                        local prompt = targetObj:FindFirstChildWhichIsA("ProximityPrompt", true)
                        if prompt then fireproximityprompt(prompt) end
                        
                        local click = targetObj:FindFirstChildWhichIsA("ClickDetector", true)
                        if click then fireclickdetector(click) end
                    end
                end
            end
        end
    end
end)

-- Отрисовка визуалов (ESP)
task.spawn(function()
    while task.wait(1.5) do
        if currentMode == "OFF" then
            for p, d in pairs(tracked) do d.hl:Destroy(); d.bb:Destroy(); tracked[p] = nil end
        else
            for part, data in pairs(tracked) do
                if not part.Parent then
                    data.hl:Destroy(); data.bb:Destroy(); tracked[part] = nil
                end
            end

            for _, obj in ipairs(Workspace:GetDescendants()) do
                if (obj:IsA("BasePart") or obj:IsA("Model")) and not tracked[obj] and obj ~= espFolder then
                    if isItem(obj, currentMode) then
                        createVisual(obj, COLORS[currentMode])
                    end
                end
            end
        end
    end
end)
