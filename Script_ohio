createButton("Деньги / Сейфы", "Money", Color3.fromRGB(255, 200, 0), 150)
createButton("Еда", "Food", Color3.fromRGB(0, 255, 150), 185)
createButton("AFK Фарм (Банк)", "AFKBank", Color3.fromRGB(255, 50, 50), 220)

local espFolder = Instance.new("Folder", Workspace)

local function createVisual(part, color)
    if tracked[part] then return end
    local hl = Instance.new("Highlight")
    hl.FillColor = color
    hl.FillTransparency = 0.5
    hl.OutlineColor = color
    hl.Adornee = part
    hl.Parent = espFolder
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 150, 0, 20)
    bb.AlwaysOnTop = true
    bb.Adornee = part
    bb.Parent = espFolder
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = color
    lbl.Text = part.Name
    lbl.Parent = bb
    tracked[part] = {hl=hl, bb=bb}
end

-- ===== ЛОГИКА AFK ФАРМА БАНКА =====
local safePosition = nil -- Запоминаем, где ты стоял до телепорта

task.spawn(function()
    while task.wait(0.5) do
        if afkFarmBank and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then continue end

            -- Если мы еще не сохранили безопасную точку, сохраняем текущую
            if not safePosition then
                safePosition = hrp.CFrame
            end

            -- 1. Ищем хранилище (Vault) и проверяем, ОТКРЫТО ли оно
            local vault = nil
            local isOpen = false
            
            for _, obj in ipairs(Workspace:GetDescendants()) do
                local n = obj.Name:lower()
                if (n:find("vault") or n:find("bankdoor") or n:find("bank_door")) and not n:find("sign") then
                    vault = obj
                    -- Проверяем, открыта ли дверь (прозрачная или не имеет коллизии)
                    if obj:IsA("BasePart") then
                        if obj.Transparency > 0.5 or obj.CanCollide == false then
                            isOpen = true
                        end
                    end
                    break
                end
            end

            if vault and isOpen then
                -- 2. Ищем деньги внутри банка
                local closestMoney = nil
                local minDist = 500
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj:IsA("BasePart") or obj:IsA("Model") then
                        local n = obj.Name:lower()
                        if n:find("cash") or n:find("money") or n:find("dollar") then
                            local pos = obj:IsA("BasePart") and obj.Position or (obj.PrimaryPart and obj.PrimaryPart.Position)
                            if pos then
                                local d = (pos - hrp.Position).Magnitude
                                if d < minDist then
                                    minDist = d
                                    closestMoney = obj
                                end
                            end
                        end
                    end
                end

                -- 3. Если нашли деньги — ТП к ним и сбор
                if closestMoney then
                    local pos = closestMoney:IsA("BasePart") and closestMoney.Position or closestMoney.PrimaryPart.Position
                    hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
                    task.wait(0.1)
                    
                    -- Жмем кнопку "Украсть" на экране
                    for _, gui in ipairs(playerGui:GetDescendants()) do
                        if (gui:IsA("TextButton") or gui:IsA("ImageButton")) and (gui.Text:lower():find("украсть") or gui.Text:lower():find("взять")) then
                            gui:Click()
                        end
                    end
                    -- Если есть кликдетектор
                    local click = closestMoney:FindFirstChildWhichIsA("ClickDetector", true)
                    if click then fireclickdetector(click) end
                else
                    -- 4. Если денег нет, но дверь открыта — просто стоим внутри (ждем спавна денег)
                end
            else
                -- 5. Если дверь ЗАКРЫТА — телепортируемся обратно в безопасное место!
                if safePosition and (hrp.Position - safePosition.Position).Magnitude > 10 then
                    hrp.CFrame = safePosition
                end
            end
        else
            -- Если фарм выключен, сбрасываем сохраненную точку
            safePosition = nil
        end
    end
end)

