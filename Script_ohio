local espFolder = Instance.new("Folder", Workspace)

local function createVisual(part, color)
    if tracked[part] then return end
    local hl = Instance.new("Highlight")
    hl.FillColor = color
    hl.FillTransparency = 0.5
    hl.OutlineColor = color
    hl.Adornee = part
    hl.Parent = espFolder
    
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 150, 0, 20)
    bb.AlwaysOnTop = true
    bb.Adornee = part
    bb.Parent = espFolder
    
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = color
    lbl.Text = part.Name
    lbl.Parent = bb
    tracked[part] = {hl=hl, bb=bb}
end

-- Умный фильтр, который ищет ТОЛЬКО сами предметы (а не здания)
local function isItem(obj, category)
    local n = obj.Name:lower()
    
    -- Жестко отсеиваем мусор, чтобы не лагало
    if n:find("sign") or n:find("wall") or n:find("mesh") or n:find("part") or n:find("material") or n:find("building") or n:find("mug") or n:find("cup") or n:find("tower") then 
        return false 
    end

    -- Проверяем, можно ли это подобрать (обычно у лута есть ClickDetector или ProximityPrompt)
    local isPickable = obj:FindFirstChildWhichIsA("ClickDetector") or obj:FindFirstChildWhichIsA("ProximityPrompt") or obj:FindFirstChild("Handle")

    if category == "Weapon" then
        return isPickable and (n:find("gun") or n:find("ak47") or n:find("m4") or n:find("pistol") or n:find("shotgun") or n:find("rifle"))
    elseif category == "Armor" then
        return isPickable and (n:find("armor") or n:find("vest") or n:find("helmet"))
    elseif category == "Money" then
        return (n:find("atm") or n:find("vault") or n:find("safe") or n:find("register") or n:find("cash")) and not n:find("sign")
    elseif category == "Food" then
        return isPickable and (n:find("food") or n:find("medkit") or n:find("bandage") or n:find("apple") or n:find("burger") or n:find("water"))
    end
    return false
end

-- Логика Авто-Фарма (машет кулаками по банкоматам)
task.spawn(function()
    while task.wait(0.3) do
        if autoFarm and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            local tool = player.Character:FindFirstChildWhichIsA("Tool")
            
            if hrp then
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj:IsA("BasePart") then
                        local n = obj.Name:lower()
                        if (n:find("atm") or n:find("register") or n:find("vault") or n:find("cash") or n:find("money") or n:find("safe")) and not n:find("sign") then
                            local dist = (obj.Position - hrp.Position).Magnitude
                            if dist < 15 then
                                -- Если есть инструмент (кулаки/бита), бьем
                                if tool and tool:FindFirstChild("Handle") then
                                    tool:Activate()
                                end
                                -- Если есть кнопка (ProximityPrompt), нажимаем
                                local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt")
                                if prompt then
                                    fireproximityprompt(prompt)
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

-- Отрисовка ESP (сканируем раз в 1.5 секунды, чтобы не лагало)
task.spawn(function()
    while task.wait(1.5) do
        if currentMode == "OFF" then
            for p, d in pairs(tracked) do d.hl:Destroy(); d.bb:Destroy(); tracked[p] = nil end
        else
            for part, data in pairs(tracked) do
                if not part.Parent then
                    data.hl:Destroy(); data.bb:Destroy(); tracked[part] = nil
                end
            end

            for _, obj in ipairs(Workspace:GetDescendants()) do
                if (obj:IsA("BasePart") or obj:IsA("Model")) and not tracked[obj] and obj ~= espFolder then
                    if isItem(obj, currentMode) then
                        createVisual(obj, COLORS[currentMode])
                    end
                end
            end
        end
    end
end)
