local espFolder = Instance.new("Folder", Workspace)

local function createVisual(part, color, category)
    if tracked[part] then return end
    local hl = Instance.new("Highlight"); hl.FillColor = color; hl.FillTransparency = 0.5; hl.OutlineColor = color; hl.Adornee = part; hl.Parent = espFolder
    local bb = Instance.new("BillboardGui"); bb.Size = UDim2.new(0, 150, 0, 20); bb.AlwaysOnTop = true; bb.Adornee = part; bb.Parent = espFolder
    local lbl = Instance.new("TextLabel"); lbl.Size = UDim2.new(1, 0, 1, 0); lbl.BackgroundTransparency = 1; lbl.TextColor3 = color; lbl.Text = string.sub(part.Name, 1, 15); lbl.Parent = bb
    tracked[part] = {hl=hl, bb=bb, cat=category}
end

local function isItem(obj, category)
    local n = obj.Name:lower()
    if #obj.Name > 25 then return false end
    
    -- Убираем мусор
    if n:find("sign") or n:find("wall") or n:find("mesh") or n:find("part") or n:find("building") or n:find("floor") or n:find("store") or n:find("locker") or n:find("shop") or n:find("door") then return false end

    local isGun = n:find("gun") or n:find("ak47") or n:find("m4") or n:find("pistol") or n:find("shotgun") or n:find("rifle") or n:find("deagle") or n:find("glock")
    local isCard = n:find("card") or n:find("keycard")
    
    if category == "ShopWeapon" then 
        return isGun and (obj:FindFirstChild("Price") or obj:FindFirstChild("Cost") or obj:FindFirstChildWhichIsA("NumberValue"))
    elseif category == "DropWeapon" then 
        local isPickable = obj:FindFirstChildWhichIsA("ClickDetector") or obj:FindFirstChildWhichIsA("ProximityPrompt")
        local hasPrice = obj:FindFirstChild("Price") or obj:FindFirstChild("Cost")
        return isGun and isPickable and not hasPrice
    elseif category == "Armor" then 
        return (n:find("armor") or n:find("vest") or n:find("helmet") or n:find("жилет")) and not n:find("room")
    elseif category == "Money" then 
        return (n == "cash" or n == "money" or n:find("bankcash") or n:find("moneydrop")) and not n:find("atm")
    elseif category == "Food" then 
        return (n:find("аптеч") or n:find("повяз") or n:find("medkit")) 
    elseif category == "AllCards" then
        return isCard
    end
    return false
end

-- БЫСТРЫЙ РАДАР (БЕЗ ЛАГОВ)
task.spawn(function()
    while task.wait(1.5) do
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            -- Очистка старых меток
            for p, d in pairs(tracked) do
                if not p.Parent or not espToggles[d.cat] then
                    d.hl:Destroy(); d.bb:Destroy(); tracked[p] = nil
                end
            end
            
            -- Используем GetPartBoundsInRadius (Радар ищет только рядом с тобой, 150 метров)
            -- Это НЕ вызывает зависаний в отличие от сканирования всей карты
            local parts = Workspace:GetPartBoundsInRadius(hrp.Position, 150)
            local checked = {}
            
            for _, part in ipairs(parts) do
                local obj = part
                if part.Parent and (part.Parent:IsA("Model") or part.Parent:IsA("Tool")) then
                    obj = part.Parent
                end
                
                local isPlayer = Players:GetPlayerFromCharacter(obj) or (obj.Parent and Players:GetPlayerFromCharacter(obj.Parent))
                
                if not checked[obj] and not tracked[obj] and not isPlayer then
                    checked[obj] = true
                    
                    for cat, isOn in pairs(espToggles) do
                        if isOn and isItem(obj, cat) then 
                            createVisual(obj, ESP_COLORS[cat], cat) 
                        end
                    end
                end
            end
        end
    end
end)

