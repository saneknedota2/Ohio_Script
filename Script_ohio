-- АВТО-ФАРМ (ТОЛЬКО КУПЮРЫ, МГНОВЕННЫЙ ТЕЛЕПОРТ)
-- ==========================================
task.spawn(function()
    while task.wait(0.2) do
        if autoFarmBank and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            local hum = player.Character:FindFirstChild("Humanoid")
            
            if hrp and hum then
                local targetCash = nil
                local shortestDist = math.huge
                
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    local n = obj.Name:lower()
                    if (n == "cash" or n == "money" or n:find("bankcash") or n:find("moneydrop")) then
                        if not (n:find("atm") or n:find("register") or n:find("safe") or n:find("tutorial") or n:find("vault")) then
                            local pos = obj:IsA("BasePart") and obj.Position or (obj.PrimaryPart and obj.PrimaryPart.Position)
                            if pos then
                                local dist = (pos - hrp.Position).Magnitude
                                if dist < shortestDist then
                                    shortestDist = dist
                                    targetCash = obj
                                end
                            end
                        end
                    end
                end

                if targetCash then
                    local pos = targetCash:IsA("BasePart") and targetCash.Position or (targetCash.PrimaryPart and targetCash.PrimaryPart.Position)
                    if pos then
                        pcall(function()
                            hrp.CFrame = CFrame.new(pos + Vector3.new(0, 2, 0))
                            hum.WalkSpeed = 16
                            local prompt = targetCash:FindFirstChildWhichIsA("ProximityPrompt", true)
                            if prompt then fireproximityprompt(prompt) end
                            local click = targetCash:FindFirstChildWhichIsA("ClickDetector", true)
                            if click then fireclickdetector(click) end
                        end)
                    end
                end
            end
        end
    end
end)
