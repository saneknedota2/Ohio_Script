local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local COLORS = {
    ShopWeapon = Color3.fromRGB(255, 100, 100),
    DropWeapon = Color3.fromRGB(255, 0, 0),
    Armor      = Color3.fromRGB(50, 150, 255),
    Money      = Color3.fromRGB(255, 200, 0),
    Food       = Color3.fromRGB(0, 255, 150)
}

local currentMode = "OFF"
local autoFarmBank = false
local tracked = {}

-- GUI
