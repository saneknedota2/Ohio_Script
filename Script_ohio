Instance.new("UICorner", mainFrame).CornerRadius = UDim.new(0, 8)

local scroll = Instance.new("ScrollingFrame")
scroll.Size = UDim2.new(1, -10, 1, -10)
scroll.Position = UDim2.new(0, 5, 0, 5)
scroll.BackgroundTransparency = 1
scroll.CanvasSize = UDim2.new(0, 0, 0, 500)
scroll.Parent = mainFrame
local list = Instance.new("UIListLayout", scroll)
list.Padding = UDim.new(0, 5)

-- Кнопки
local function createToggle(name, accent)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 35)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    btn.Text = name .. ": OFF"
    btn.TextColor3 = Color3.fromRGB(200, 200, 210)
    btn.Parent = scroll
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    btn:SetAttribute("Enabled", false)
    btn.MouseButton1Click:Connect(function()
        local on = not btn:GetAttribute("Enabled")
        btn:SetAttribute("Enabled", on)
        btn.Text = name .. ": " .. (on and "ON" or "OFF")
        btn.BackgroundColor3 = on and accent or Color3.fromRGB(30, 30, 40)
        btn.TextColor3 = on and Color3.new(0,0,0) or Color3.fromRGB(200, 200, 210)
    end)
    return btn
end

local toggleBank = createToggle("Bank / Vault", COLORS.Bank)
local toggleJeweler = createToggle("Jeweler / Safe", COLORS.Jeweler)
local toggleItems = createToggle("Items", COLORS.Item)

-- Поиск
local searchBox = Instance.new("TextBox")
searchBox.Size = UDim2.new(1, 0, 0, 35)
searchBox.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
searchBox.PlaceholderText = "Поиск предмета (например: cash)"
searchBox.Text = ""
searchBox.TextColor3 = Color3.new(1,1,1)
searchBox.Font = Enum.Font.Gotham
searchBox.TextSize = 13
searchBox.Parent = scroll
Instance.new("UICorner", searchBox).CornerRadius = UDim.new(0, 6)

-- ==== ЛОГИКА ====
local espFolder = Instance.new("Folder", Workspace)
local tracked = {}

local function createVisual(part, color)
    if tracked[part] then return end
    local hl = Instance.new("Highlight")
    hl.FillColor = color
    hl.FillTransparency = 0.5
    hl.OutlineColor = color
    hl.Adornee = part
    hl.Parent = espFolder
    
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 200, 0, 20)
    bb.AlwaysOnTop = true
    bb.Adornee = part
    bb.Parent = espFolder
    
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = color
    lbl.Text = part.Name
    lbl.Parent = bb
    tracked[part] = {hl=hl, bb=bb}
end

RunService.Heartbeat:Connect(function()
    local sText = searchBox.Text:lower()
    
    -- Удаляем старые метки, если кнопки выключены или если это стены
    for part, data in pairs(tracked) do
        if not part.Parent or 
           (data.color == COLORS.Bank and not toggleBank:GetAttribute("Enabled")) or
           (data.color == COLORS.Jeweler and not toggleJeweler:GetAttribute("Enabled")) or
           (data.color == COLORS.Item and not toggleItems:GetAttribute("Enabled")) or
           (sText ~= "" and not part.Name:lower():find(sText)) then
            data.hl:Destroy()
            data.bb:Destroy()
            tracked[part] = nil
        end
    end

    -- Ищем новые
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if (obj:IsA("BasePart") or obj:IsA("Model")) and not tracked[obj] and obj ~= espFolder then
            local n = obj.Name:lower()
            
            -- Проверка на поиск
            if sText ~= "" and n:find(sText) then
                createVisual(obj, COLORS.Search)
            else
                -- Банк
                if toggleBank:GetAttribute("Enabled") then
                    for _, k in ipairs(KEYWORDS.Bank) do if n:find(k) then createVisual(obj, COLORS.Bank) end end
                end
                -- Ювелирка
                if toggleJeweler:GetAttribute("Enabled") then
                    for _, k in ipairs(KEYWORDS.Jeweler) do if n:find(k) then createVisual(obj, COLORS.Jeweler) end end
                end
                -- Предметы
                if toggleItems:GetAttribute("Enabled") then
                    for _, k in ipairs(KEYWORDS.Item) do if n:find(k) then createVisual(obj, COLORS.Item) end end
                end
            end
        end
    end
end)
