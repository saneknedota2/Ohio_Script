local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Настройки
local WEAPON_KEYWORDS = { "gun", "weapon", "ak", "m4", "pistol", "shotgun", "knife", "ammo", "glock" }
local ITEM_KEYWORDS = { "cash", "money", "loot", "pickup", "item" }
local BANK_KEYWORDS = { "vault", "safe", "deposit", "bank" }
local JEWEL_KEYWORDS = { "jewel", "gem", "diamond", "ring" }

local COLORS = {
    Weapon = Color3.fromRGB(255, 50, 50),
    Item   = Color3.fromRGB(0, 255, 150),
    Bank   = Color3.fromRGB(255, 200, 0),
    Jewel  = Color3.fromRGB(180, 100, 255)
}

local currentMode = "OFF"
local customSearch = ""
local tracked = {}

-- GUI
local screenGui = Instance.new("ScreenGui")
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 220, 0, 220)
mainFrame.Position = UDim2.new(0, 20, 0, 80)
mainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
mainFrame.BorderSizePixel = 0
mainFrame.Parent = screenGui
Instance.new("UICorner", mainFrame).CornerRadius = UDim.new(0, 8)

-- Выпадающий список (имитация кнопками)
local function createButton(text, mode, color)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 30)
    btn.Position = UDim2.new(0, 10, 0, 10 + (#mainFrame:GetChildren() * 5) * 30) -- авто-позиция
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 13
    btn.Parent = mainFrame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    
    btn.MouseButton1Click:Connect(function()
        currentMode = mode
        customSearch = ""
        searchBox.Text = ""
        -- Очистка визуалов при переключении
        for p, d in pairs(tracked) do d.hl:Destroy(); d.bb:Destroy(); tracked[p] = nil end
        
        -- Визуал нажатой кнопки
        for _, child in ipairs(mainFrame:GetChildren()) do
            if child:IsA("TextButton") then
                child.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
            end
        end
        btn.BackgroundColor3 = color
    end)
end

createButton("ВЫКЛЮЧИТЬ ВСЁ", "OFF", Color3.fromRGB(60,60,60))
createButton("Все Оружие", "Weapon", COLORS.Weapon)
createButton("Все Предметы (Кэш/Лут)", "Item", COLORS.Item)
createButton("Банк / Сейфы", "Bank", COLORS.Bank)
createButton("Ювелирка", "Jewel", COLORS.Jewel)

-- Строка поиска
local searchBox = Instance.new("TextBox")
searchBox.Size = UDim2.new(1, -20, 0, 30)
searchBox.Position = UDim2.new(0, 10, 1, -40)
searchBox.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
searchBox.PlaceholderText = "Введи название (например: ak)"
searchBox.Text = ""
searchBox.TextColor3 = Color3.new(1,1,1)
searchBox.Font = Enum.Font.Gotham
searchBox.TextSize = 13
searchBox.Parent = mainFrame
Instance.new("UICorner", searchBox).CornerRadius = UDim.new(0, 6)

searchBox:GetPropertyChangedSignal("Text"):Connect(function()
    customSearch = searchBox.Text:lower()
    if customSearch ~= "" then
        currentMode = "Search"
        for p, d in pairs(tracked) do d.hl:Destroy(); d.bb:Destroy(); tracked[p] = nil end
    end
end)

-- Хранилище визуалов
local espFolder = Instance.new("Folder", Workspace)

local function createVisual(part, color)
    if tracked[part] then return end
    local hl = Instance.new("Highlight")
    hl.FillColor = color
    hl.FillTransparency = 0.5
    hl.OutlineColor = color
    hl.Adornee = part
    hl.Parent = espFolder
    
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 200, 0, 20)
    bb.AlwaysOnTop = true
    bb.Adornee = part
    bb.Parent = espFolder
    
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = color
    lbl.Text = part.Name
    lbl.Parent = bb
    tracked[part] = {hl=hl, bb=bb}
end

-- Функция проверки совпадений
local function checkMatch(name, keywords)
    for _, k in ipairs(keywords) do
        if name:find(k) then return true end
    end
    return false
end

-- Сканирование (раз в 2 секунды, чтобы не лагало)
task.spawn(function()
    while task.wait(2) do
        if currentMode == "OFF" then
            for p, d in pairs(tracked) do d.hl:Destroy(); d.bb:Destroy(); tracked[p] = nil end
        else
            for part, data in pairs(tracked) do
                if not part.Parent then
                    data.hl:Destroy(); data.bb:Destroy(); tracked[part] = nil
                end
            end

            for _, obj in ipairs(Workspace:GetDescendants()) do
                if (obj:IsA("BasePart") or obj:IsA("Model")) and not tracked[obj] and obj ~= espFolder then
                    local n = obj.Name:lower()
                    if currentMode == "Search" and n:find(customSearch) then
                        createVisual(obj, Color3.fromRGB(255, 255, 255))
                    elseif currentMode == "Weapon" and checkMatch(n, WEAPON_KEYWORDS) then
                        createVisual(obj, COLORS.Weapon)
                    elseif currentMode == "Item" and checkMatch(n, ITEM_KEYWORDS) then
                        createVisual(obj, COLORS.Item)
                    elseif currentMode == "Bank" and checkMatch(n, BANK_KEYWORDS) then
                        createVisual(obj, COLORS.Bank)
                    elseif currentMode == "Jewel" and checkMatch(n, JEWEL_KEYWORDS) then
                        createVisual(obj, COLORS.Jewel)
                    end
                end
            end
        end
    end
end)
