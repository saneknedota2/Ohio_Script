local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local VirtualUser = game:GetService("VirtualUser")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- ==========================================
-- 1. ПЛАВАЮЩАЯ КНОПКА (Вместо авто-хила и фарма)
-- ==========================================
local screenGui = Instance.new("ScreenGui")
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

local actionBtn = Instance.new("TextButton")
actionBtn.Size = UDim2.new(0, 70, 0, 70)
actionBtn.Position = UDim2.new(0.8, 0, 0.6, 0)
actionBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
actionBtn.BackgroundTransparency = 0.2
actionBtn.Text = "ДЕЙСТВИЕ\n(E + Хил)"
actionBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
actionBtn.Font = Enum.Font.GothamBold
actionBtn.TextSize = 12
actionBtn.Parent = screenGui
Instance.new("UICorner", actionBtn).CornerRadius = UDim.new(1, 0)

-- Делаем кнопку перетаскиваемой
local dragging, dragInput, dragStart, startPos
actionBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = actionBtn.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)
actionBtn.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        actionBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- Логика нажатия на кнопку
actionBtn.MouseButton1Click:Connect(function()
    -- 1. Пытаемся нажать E (для сбора)
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:KeyDown(Enum.KeyCode.E)
        task.wait(0.1)
        VirtualUser:KeyUp(Enum.KeyCode.E)
    end)
    
    -- 2. Пытаемся использовать аптечку, если ХП меньше 70
    local char = player.Character
    if char and char:FindFirstChild("Humanoid") and char.Humanoid.Health < 70 then
        local backpack = player:FindFirstChild("Backpack")
        if backpack then
            for _, item in ipairs(backpack:GetChildren()) do
                if item:IsA("Tool") then
                    local n = item.Name:lower()
                    if n:find("аптеч") or n:find("повяз") or n:find("бинт") then
                        item.Parent = char
                        task.wait(0.1)
                        pcall(function() item:Activate() end)
                        task.wait(0.5)
                        if item.Parent == char then item.Parent = backpack end
                        break
                    end
                end
            end
        end
    end
end)

-- ==========================================
-- 2. КРУТОЙ ESP НА ИГРОКОВ (Квадраты + Инфо)
-- ==========================================
local espFolder = Instance.new("Folder", Workspace)
local trackedPlayers = {}

local function createPlayerESP(otherPlayer)
    local char = otherPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- Создаем контейнер (BillboardGui)
    local bb = Instance.new("BillboardGui")
    bb.Name = otherPlayer.Name .. "_ESP"
    bb.Size = UDim2.new(0, 200, 0, 100)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    bb.Adornee = hrp
    bb.Parent = espFolder

    -- Квадрат (Box) вокруг игрока
    local box = Instance.new("Frame")
    box.Size = UDim2.new(0, 50, 0, 70)
    box.Position = UDim2.new(0.5, -25, 0.5, -35)
    box.BackgroundTransparency = 1
    box.Parent = bb
    
    local stroke = Instance.new("UIStroke", box)
    stroke.Color = Color3.fromRGB(255, 0, 0)
    stroke.Thickness = 2

    -- Текст (Ник, ХП, Щит, Оружие)
    local infoLabel = Instance.new("TextLabel")
    infoLabel.Size = UDim2.new(1, 0, 0, 30)
    infoLabel.Position = UDim2.new(0, 0, 0, -30)
    infoLabel.BackgroundTransparency = 1
    infoLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    infoLabel.TextStrokeTransparency = 0
    infoLabel.Font = Enum.Font.GothamBold
    infoLabel.TextSize = 12
    infoLabel.Text = "Загрузка..."
    infoLabel.Parent = bb

    trackedPlayers[otherPlayer] = {bb = bb, label = infoLabel, box = box}
end

-- Функция обновления текста
RunService.Heartbeat:Connect(function()
    for p, data in pairs(trackedPlayers) do
        local char = p.Character
        if char and data.label.Parent then
            local hum = char:FindFirstChild("Humanoid")
            local hp = hum and math.floor(hum.Health) or 0
            
            -- Ищем щит (обычно это Value внутри персонажа)
            local shieldVal = char:FindFirstChild("Shield") or char:FindFirstChild("Armor") or char:FindFirstChild("MaxShield")
            local shield = shieldVal and math.floor(shieldVal.Value) or 0
            
            -- Ищем оружие в руках
            local tool = char:FindFirstChildWhichIsA("Tool")
            local toolName = tool and tool.Name or "Кулаки"
            
            -- Форматируем текст
            data.label.Text = string.format("[%s]\nHP: %d | Щит: %d\nВ руках: %s", p.DisplayName, hp, shield, toolName)
            
            -- Меняем цвет полоски в зависимости от ХП
            if hp < 30 then
                data.box.UIStroke.Color = Color3.fromRGB(255, 0, 0) -- Красный (опасно)
            elseif hp < 70 then
                data.box.UIStroke.Color = Color3.fromRGB(255, 150, 0) -- Оранжевый
            else
                data.box.UIStroke.Color = Color3.fromRGB(0, 255, 0) -- Зеленый (полное)
            end
        end
    end
end)

-- Подключение игроков
local function setupPlayer(p)
    if p ~= player then
        p.CharacterAdded:Connect(function()
            task.wait(1) -- Ждем загрузки персонажа
            createPlayerESP(p)
        end)
        if p.Character then
            createPlayerESP(p)
        end
    end
end

for _, p in ipairs(Players:GetPlayers()) do setupPlayer(p) end
Players.PlayerAdded:Connect(setupPlayer)

Players.PlayerRemoving:Connect(function(p)
    if trackedPlayers[p] then
        trackedPlayers[p].bb:Destroy()
        trackedPlayers[p] = nil
    end
end)
