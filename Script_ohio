local function createPage(name)
    local frame = Instance.new("ScrollingFrame")
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundTransparency = 1
    frame.BorderSizePixel = 0
    frame.ScrollBarThickness = 2
    frame.Visible = false
    frame.Parent = pageContainer
    local layout = Instance.new("UIListLayout", frame)
    layout.Padding = UDim.new(0, 8)
    pages[name] = frame
    return frame
end

local pageMain = createPage("main")
local pageESP = createPage("ESP")
local pageHuman = createPage("HUMAN")

local function switchTab(tabName)
    for name, frame in pairs(pages) do frame.Visible = (name == tabName) end
    for tabText, btn in pairs(tabButtons) do
        btn.TextColor3 = (tabText == tabName) and Color3.fromRGB(0, 150, 255) or Color3.fromRGB(200, 200, 200)
    end
end

local function createTabButton(text, tabName)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 70, 0, 30)
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
    btn.Text = text
    btn.Font = Enum.Font.GothamBold
