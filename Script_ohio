task.spawn(function()
    while task.wait(0.5) do 
        if autoHealEnabled and player.Character and not isHealing then
            local hum = player.Character:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 and hum.Health < healThreshold then
                local backpack = player:FindFirstChild("Backpack")
                if backpack then
                    for _, item in ipairs(backpack:GetChildren()) do
                        if item:IsA("Tool") then
                            local n = item.Name:lower()
                            if n:find("аптеч") or n:find("повяз") or n:find("med") then
                                isHealing = true
                                local currentTool = player.Character:FindFirstChildWhichIsA("Tool")
                                
                                item.Parent = player.Character
                                task.wait(0.2) 
                                pcall(function() item:Activate() end)
                                task.wait(1) 
                                
                                if item.Parent == player.Character then item.Parent = backpack end
                                task.wait(0.1)
                                if currentTool and currentTool.Parent == backpack then currentTool.Parent = player.Character end
                                
                                isHealing = false
                                break
                            end
                        end
                    end
                end
            end
        end
    end
end)

