local function createItemVisual(obj, color, category)
    if trackedItems[obj] then return end
    local hl = Instance.new("Highlight"); hl.FillColor = color; hl.FillTransparency = 0.5; hl.OutlineColor = color; hl.Adornee = obj; hl.Parent = espFolder
    local bb = Instance.new("BillboardGui"); bb.Size = UDim2.new(0, 150, 0, 20); bb.AlwaysOnTop = true; bb.Adornee = obj; bb.Parent = espFolder
    local lbl = Instance.new("TextLabel"); lbl.Size = UDim2.new(1, 0, 1, 0); lbl.BackgroundTransparency = 1; lbl.TextColor3 = color; lbl.Text = string.sub(obj.Name, 1, 15); lbl.Parent = bb
    trackedItems[obj] = {hl=hl, bb=bb, cat=category}
end

task.spawn(function()
    while task.wait(1.5) do
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            for p, d in pairs(trackedItems) do
                if not p.Parent or not espToggles[d.cat] then
                    d.hl:Destroy(); d.bb:Destroy(); trackedItems[p] = nil
                end
            end
            
            local parts = Workspace:GetPartBoundsInRadius(hrp.Position, 300)
            local checked = {}
            local count = 0
            
            for _, part in ipairs(parts) do
                local obj = part
                if part.Parent and (part.Parent:IsA("Model") or part.Parent:IsA("Tool")) then obj = part.Parent end
                local isPlayer = Players:GetPlayerFromCharacter(obj) or (obj.Parent and Players:GetPlayerFromCharacter(obj.Parent))
                
                if not checked[obj] and not trackedItems[obj] and not isPlayer then
                    checked[obj] = true
                    local n = obj.Name:lower()
                    if not (n:find("wall") or n:find("floor") or n:find("mesh") or n:find("door") or #obj.Name > 25) then
                        local isGun = n:find("gun") or n:find("ak47") or n:find("m4") or n:find("pistol") or n:find("deagle")
                        local isFood = n:find("food") or n:find("аптеч") or n:find("повяз") or n:find("medkit")
                        
                        local isJewel = false
                        for _, kw in ipairs(GEM_KEYWORDS) do
                            if n:find(kw) then isJewel = true break end
                        end

                        if espToggles.ShopWeapon and isGun and (obj:FindFirstChild("Price") or obj:FindFirstChildWhichIsA("NumberValue")) then
                            createItemVisual(obj, ESP_COLORS.ShopWeapon, "ShopWeapon"); count = count + 1
                        elseif espToggles.DropWeapon and isGun and not (obj:FindFirstChild("Price")) then
                            createItemVisual(obj, ESP_COLORS.DropWeapon, "DropWeapon"); count = count + 1
                        elseif espToggles.Food and isFood then
                            createItemVisual(obj, ESP_COLORS.Food, "Food"); count = count + 1
                        elseif espToggles.Money and (n == "cash" or n == "money" or n:find("bankcash")) then
                            createItemVisual(obj, ESP_COLORS.Money, "Money"); count = count + 1
                        elseif espToggles.Armor and (n:find("armor") or n:find("vest") or n:find("жилет")) then
                            createItemVisual(obj, ESP_COLORS.Armor, "Armor"); count = count + 1
                        elseif espToggles.Jewel and isJewel then
                            createItemVisual(obj, ESP_COLORS.Jewel, "Jewel"); count = count + 1
                        end
                    end
                end
                if count > 30 then break end
            end
        end
    end
end)
