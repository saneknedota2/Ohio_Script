local espFolder = Instance.new("Folder", Workspace)

local function createVisual(obj, color, cat)
    if tracked[obj] then return end
    local hl = Instance.new("Highlight")
    hl.FillColor = color
    hl.FillTransparency = 0.5
    hl.OutlineColor = color
    hl.Adornee = obj
    hl.Parent = espFolder
    
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 150, 0, 20)
    bb.AlwaysOnTop = true
    bb.Adornee = obj
    bb.Parent = espFolder
    
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = color
    lbl.Text = obj.Name
    lbl.Parent = bb
    
    tracked[obj] = {hl=hl, bb=bb, cat=cat}
end

task.spawn(function()
    while task.wait(2) do
        for p, d in pairs(tracked) do
            if not p.Parent or not espToggles[d.cat] then
                d.hl:Destroy(); d.bb:Destroy(); tracked[p] = nil
            end
        end
        
        -- Просто перебираем ВСЕ объекты в игре
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if not tracked[obj] then
                local n = obj.Name:lower()
                
                -- Пропускаем игроков
                if not Players:GetPlayerFromCharacter(obj) and not (obj.Parent and Players:GetPlayerFromCharacter(obj.Parent)) then
                    
                    -- ДЕНЬГИ
                    if (n == "cash" or n == "money" or n:find("bankcash")) and espToggles.Money then
                        createVisual(obj, ESP_COLORS.Money, "Money")
                    
                    -- ОРУЖИЕ
                    elseif (n:find("gun") or n:find("ak47") or n:find("m4") or n:find("glock") or n:find("deagle") or n:find("m1911") or n:find("сайга")) then
                        local hasPrice = obj:FindFirstChild("Price") or obj:FindFirstChildWhichIsA("NumberValue")
                        if hasPrice and espToggles.ShopWeapon then
                            createVisual(obj, ESP_COLORS.ShopWeapon, "ShopWeapon")
                        elseif not hasPrice and espToggles.DropWeapon then
                            createVisual(obj, ESP_COLORS.DropWeapon, "DropWeapon")
                        end
                    
                    -- КАРТОЧКИ
                    elseif (n:find("card") or n:find("key")) and espToggles.AllCards then
                        createVisual(obj, ESP_COLORS.AllCards, "AllCards")
                    
                    -- БРОНЯ
                    elseif (n:find("armor") or n:find("vest")) and espToggles.Armor then
                        createVisual(obj, ESP_COLORS.Armor, "Armor")
                    end
                end
            end
        end
    end
end)

