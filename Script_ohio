local espFolder = Instance.new("Folder", Workspace)

local function createVisual(obj, color, cat)
    if tracked[obj] then return end
    local hl = Instance.new("Highlight")
    hl.FillColor = color
    hl.FillTransparency = 0.5
    hl.OutlineColor = color
    hl.Adornee = obj
    hl.Parent = espFolder
    
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 150, 0, 20)
    bb.AlwaysOnTop = true
    bb.Adornee = obj
    bb.Parent = espFolder
    
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = color
    lbl.Text = obj.Name
    lbl.Parent = bb
    
    tracked[obj] = {hl=hl, bb=bb, cat=cat}
end

local function getAllObjects()
    local objects = {}
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") or obj:IsA("Tool") or obj:IsA("BasePart") or obj:IsA("Folder") then
            for _, child in ipairs(obj:GetDescendants()) do
                if child:IsA("Model") or child:IsA("Tool") or child:IsA("BasePart") then
                    table.insert(objects, child)
                end
            end
        end
    end
    return objects
end

task.spawn(function()
    while task.wait(2) do
        for p, d in pairs(tracked) do
            if not p.Parent or not espToggles[d.cat] then
                d.hl:Destroy(); d.bb:Destroy(); tracked[p] = nil
            end
        end
        
        local parts = getAllObjects()
        local checked = {}
        local count = 0
        
        for _, obj in ipairs(parts) do
            local isPlayer = Players:GetPlayerFromCharacter(obj) or (obj.Parent and Players:GetPlayerFromCharacter(obj.Parent))
            
            if not checked[obj] and not tracked[obj] then
                checked[obj] = true
                local n = obj.Name:lower()
                
                if isPlayer and espToggles.PlayersESP then
                    if obj:IsA("Model") and obj:FindFirstChild("Head") then
                        createVisual(obj, ESP_COLORS.PlayersESP, "PlayersESP")
                        count = count + 1
                    end
                elseif not isPlayer then
                    if not (n:find("fake") or n:find("glass") or n:find("wall") or n:find("floor") or n:find("room") or n:find("part") or n:find("hitbox") or n:find("baseplate") or n:find("atm") or n:find("tutorial") or n:find("menu")) then
                        if n:find("ak") or n:find("m4") or n:find("gun") or n:find("glock") or n:find("m1911") or n:find("deagle") or n:find("сайга") or n:find("пистолет") or n:find("оружие") then
                            local hasPrice = obj:FindFirstChild("Price") or obj:FindFirstChildWhichIsA("NumberValue") or (obj.Parent and obj.Parent:FindFirstChild("Price"))
                            if hasPrice then
                                if espToggles.ShopWeapon then createVisual(obj, ESP_COLORS.ShopWeapon, "ShopWeapon"); count = count + 1 end
                            else
                                if espToggles.DropWeapon then createVisual(obj, ESP_COLORS.DropWeapon, "DropWeapon"); count = count + 1 end
                            end
                        elseif n:find("жилет") or n:find("armor") or n:find("vest") then
                            if espToggles.Armor then createVisual(obj, ESP_COLORS.Armor, "Armor"); count = count + 1 end
                        elseif n == "cash" or n == "money" or n:find("bankcash") or n:find("moneydrop") then
                            if espToggles.Money then createVisual(obj, ESP_COLORS.Money, "Money"); count = count + 1 end
                        elseif n:find("card") or n:find("key") then
                            if espToggles.AllCards then createVisual(obj, ESP_COLORS.AllCards, "AllCards"); count = count + 1 end
                        elseif n:find("food") or n:find("medkit") or n:find("bandage") then
                            if espToggles.Food then createVisual(obj, ESP_COLORS.Food, "Food"); count = count + 1 end
                        end
                    end
                end
            end
            
            if count > 50 then break end
        end
    end
end)

