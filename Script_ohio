local function autoHackSafes()
    if isSafeFarming then return end
    isSafeFarming = true
    
    local char = player.Character
    if not char then isSafeFarming = false; return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then isSafeFarming = false; return end

    -- 1. Запоминаем точку, где мы стоим
    local startPos = hrp.CFrame
    
    -- 2. Ищем все сейфы на карте
    local safes = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        local n = obj.Name:lower()
        if n:find("safe") then
            local pos = obj:IsA("BasePart") and obj.Position or (obj.PrimaryPart and obj.PrimaryPart.Position)
            if pos then
                table.insert(safes, obj)
            end
        end
    end

    -- 3. Телепортируемся к каждому сейфу
    for _, safe in ipairs(safes) do
        local pos = safe:IsA("BasePart") and safe.Position or (safe.PrimaryPart and safe.PrimaryPart.Position)
        if pos then
            pcall(function()
                -- Телепорт к сейфу (чуть выше, чтобы не застрять)
                hrp.CFrame = CFrame.new(pos + Vector3.new(0, 2, 0))
                task.wait(0.3) -- Пауза для античита
                
                -- Нажимаем на сейф
                local prompt = safe:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt then fireproximityprompt(prompt) end
                local click = safe:FindFirstChildWhichIsA("ClickDetector", true)
                if click then fireclickdetector(click) end
                
                -- Имитация зажатия E (для взлома)
                VirtualUser:CaptureController()
                VirtualUser:KeyDown(Enum.KeyCode.E)
                task.wait(1) -- Держим секунду
                VirtualUser:KeyUp(Enum.KeyCode.E)
                
                task.wait(0.5) -- Ждем завершения взлома
            end)
        end
    end

    -- 4. Возвращаемся обратно на исходное место
    task.wait(0.5)
    hrp.CFrame = startPos
    isSafeFarming = false
end

