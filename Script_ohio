local espFolder = Instance.new("Folder", Workspace)

local function createVisual(part, color, category)
    if tracked[part] then return end
    
    -- ЛИМИТ НА КОЛИЧЕСТВО ESP, ЧТОБЫ НЕ ЛАГАЛО
    local count = 0
    for _ in pairs(tracked) do count = count + 1 end
    if count > 40 then return end

    local hl = Instance.new("Highlight"); hl.FillColor = color; hl.FillTransparency = 0.5; hl.OutlineColor = color; hl.Adornee = part; hl.Parent = espFolder
    
    local bb = Instance.new("BillboardGui"); bb.Size = UDim2.new(0, 150, 0, 20); bb.AlwaysOnTop = true
    local targetPart = part
    if part:IsA("Model") then targetPart = part.PrimaryPart or part:FindFirstChildWhichIsA("BasePart") end
    
    if targetPart then
        bb.Adornee = targetPart
        bb.Parent = espFolder
        local lbl = Instance.new("TextLabel"); lbl.Size = UDim2.new(1, 0, 1, 0); lbl.BackgroundTransparency = 1; lbl.TextColor3 = color; lbl.Text = part.Name; lbl.Parent = bb
    end
    tracked[part] = {hl=hl, bb=bb, cat=category}
    
    if category == "BlueCard" or category == "RedCard" or category == "AllCards" then
        showNotification("Найдена карточка!\n" .. part.Name, true)
    end
end

