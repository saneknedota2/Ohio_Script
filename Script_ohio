local function createToggleButton(parent, labelText, initialVal, colorOn, callback)
    local isOn = initialVal
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 35)
    btn.BackgroundColor3 = isOn and colorOn or Color3.fromRGB(40, 40, 45)
    btn.Text = labelText .. ": " .. (isOn and "ON" or "OFF")
    btn.TextColor3 = isOn and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    
    btn.MouseButton1Click:Connect(function()
        isOn = not isOn
        btn.Text = labelText .. ": " .. (isOn and "ON" or "OFF")
        btn.BackgroundColor3 = isOn and colorOn or Color3.fromRGB(40, 40, 45)
        btn.TextColor3 = isOn and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(255, 255, 255)
        if callback then callback(isOn) end
    end)
    return btn
end

local function createStatSetting(parent, label, defaultVal, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 35)
    frame.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
    frame.Parent = parent
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)
    local txtLbl = Instance.new("TextLabel")
    txtLbl.Size = UDim2.new(0.5, 0, 1, 0); txtLbl.Position = UDim2.new(0, 10, 0, 0)
    txtLbl.BackgroundTransparency = 1; txtLbl.Text = label
    txtLbl.TextColor3 = Color3.fromRGB(255, 255, 255); txtLbl.Font = Enum.Font.GothamBold; txtLbl.TextSize = 14
    txtLbl.TextXAlignment = Enum.TextXAlignment.Left; txtLbl.Parent = frame
    local txtBox = Instance.new("TextBox")
    txtBox.Size = UDim2.new(0.3, 0, 0, 25); txtBox.Position = UDim2.new(0.65, 0, 0, 5)
    txtBox.BackgroundColor3 = Color3.fromRGB(20, 20, 25); txtBox.Text = tostring(defaultVal)
    txtBox.TextColor3 = Color3.fromRGB(0, 255, 255); txtBox.Font = Enum.Font.GothamBold; txtBox.TextSize = 14
    txtBox.Parent = frame; Instance.new("UICorner", txtBox).CornerRadius = UDim.new(0, 4)
    local function apply()
        local num = tonumber(txtBox.Text)
        if num then callback(num) else txtBox.Text = tostring(defaultVal) end
    end
    txtBox.FocusLost:Connect(apply)
    txtBox.ReturnPressedFromOnScreenKeyboard:Connect(apply)
end

