local espFolder = Instance.new("Folder", Workspace)

local function createVisual(part, color, category)
    if tracked[part] then return end
    local hl = Instance.new("Highlight")
    hl.FillColor = color
    hl.FillTransparency = 0.5
    hl.OutlineColor = color
    hl.Adornee = part
    hl.Parent = espFolder
    
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 150, 0, 20)
    bb.AlwaysOnTop = true
    bb.Adornee = part
    bb.Parent = espFolder
    
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = color
    lbl.Text = part.Name
    lbl.Parent = bb
    tracked[part] = {hl=hl, bb=bb, cat=category}
end

local function isItem(obj, category)
    local n = obj.Name:lower()
    if n:find("sign") or n:find("wall") or n:find("mesh") or n:find("part") or n:find("building") or n:find("floor") then return false end
    
    if category == "Weapon" then 
        return (n:find("gun") or n:find("ak47") or n:find("m4") or n:find("pistol")) and (obj:FindFirstChildWhichIsA("ClickDetector") or obj:FindFirstChildWhichIsA("ProximityPrompt"))
    elseif category == "Armor" then 
        return (n:find("armor") or n:find("vest") or n:find("helmet")) and (obj:FindFirstChildWhichIsA("ClickDetector") or n:find("shop"))
    elseif category == "Money" then 
        return (n:find("atm") or n:find("vault") or n:find("safe") or n:find("bankcash") or n:find("cash") or n:find("money")) and not n:find("register")
    elseif category == "Food" then 
        return (n:find("food") or n:find("medkit") or n:find("bandage") or n:find("apple") or n:find("burger")) and (obj:FindFirstChildWhichIsA("ClickDetector") or n:find("shop")) 
    end
    return false
end

task.spawn(function()
    while task.wait(0.15) do 
        if autoFarmBank and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local targetObj = nil
                local shortestDist = 1000

                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj:IsA("BasePart") or obj:IsA("Model") then
                        local n = obj.Name:lower()
                        if (n == "bankcash" or n == "cash" or n == "money" or n == "moneydrop") then
                            if not (n:find("register") or n:find("atm") or n:find("cashier") or n:find("shelf") or n:find("box") or n:find("safe") or n:find("vault")) then
                                local click = obj:FindFirstChildWhichIsA("ClickDetector", true)
                                local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                                if click or prompt then
                                    local pos = obj:IsA("BasePart") and obj.Position or (obj.PrimaryPart and obj.PrimaryPart.Position)
                                    if pos then
                                        local dist = (pos - hrp.Position).Magnitude
                                        if dist < shortestDist then
                                            shortestDist = dist
                                            targetObj = obj
                                        end
                                    end
                                end
                            end
                        end
                    end
                end

                if targetObj then
                    local targetPos = targetObj:IsA("BasePart") and targetObj.Position or (targetObj.PrimaryPart and targetObj.PrimaryPart.Position)
                    if targetPos then
                        hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
                        task.wait(0.05) 
                        local prompt = targetObj:FindFirstChildWhichIsA("ProximityPrompt", true)
                        if prompt then fireproximityprompt(prompt) end
                        local click = targetObj:FindFirstChildWhichIsA("ClickDetector", true)
                        if click then fireclickdetector(click) end
                    end
                end
            end
        end
    end
end)

task.spawn(function()
    while task.wait(1) do
        for p, d in pairs(tracked) do
            if not p.Parent or not espToggles[d.cat] then
                d.hl:Destroy(); d.bb:Destroy(); tracked[p] = nil
            end
        end

        for _, obj in ipairs(Workspace:GetDescendants()) do
            if (obj:IsA("BasePart") or obj:IsA("Model")) and not tracked[obj] and obj ~= espFolder then
                for cat, isOn in pairs(espToggles) do
                    if isOn and isItem(obj, cat) then
                        createVisual(obj, ESP_COLORS[cat], cat)
                    end
                end
            end
        end
    end
end)
