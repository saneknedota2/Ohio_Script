local function getClosestTarget()
    local closestPlayer = nil
    local shortestDist = fovRadius
    local centerPos = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local head = p.Character:FindFirstChild("Head")
            if head then
                local screenPos, onScreen = camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - centerPos).Magnitude
                    if dist < shortestDist then shortestDist = dist; closestPlayer = head end
                end
            end
        end
    end
    return closestPlayer
end

local lastShootTime = 0
RunService.RenderStepped:Connect(function()
    if aimbotEnabled or autoShootEnabled then
        fovCircle.Visible = true
        fovCircle.Size = UDim2.new(0, fovRadius * 2, 0, fovRadius * 2)
    else
        fovCircle.Visible = false
    end

    if aimbotEnabled then
        local target = getClosestTarget()
        if target then camera.CFrame = CFrame.new(camera.CFrame.Position, target.Position) end
    end

    if autoShootEnabled and player.Character then
        local tool = player.Character:FindFirstChildWhichIsA("Tool")
        if tool then
            local target = getClosestTarget()
            if target and tick() - lastShootTime > 0.1 then
                lastShootTime = tick()
                pcall(function() tool:Activate() end)
            end
        end
    end
end)

