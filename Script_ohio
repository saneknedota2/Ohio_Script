local function getClosestTarget()
    local closest = nil
    local shortestDist = fovRadius
    local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local head = p.Character:FindFirstChild("Head")
            if head then
                local screenPos, onScreen = camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    if dist < shortestDist then shortestDist = dist; closest = head end
                end
            end
        end
    end
    return closest
end

local lastShoot = 0
RunService.RenderStepped:Connect(function()
    if aimbotEnabled or autoShootEnabled then
        fovCircle.Visible = true
        fovCircle.Size = UDim2.new(0, fovRadius * 2, 0, fovRadius * 2)
    else
        fovCircle.Visible = false
    end

    if aimbotEnabled then
        local target = getClosestTarget()
        if target then camera.CFrame = CFrame.new(camera.CFrame.Position, target.Position) end
    end

    if autoShootEnabled and player.Character then
        local tool = player.Character:FindFirstChildWhichIsA("Tool")
        if tool and getClosestTarget() and tick() - lastShoot > 0.1 then
            lastShoot = tick()
            pcall(function() tool:Activate() end)
        end
    end
end)

