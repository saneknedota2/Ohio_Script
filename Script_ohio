local function createESPToggle(label, key)
    local btn = createButton(pageESP, label .. ": OFF", function()
        espToggles[key] = not espToggles[key]
        btn.Text = label .. ": " .. (espToggles[key] and "ON" or "OFF")
        btn.BackgroundColor3 = espToggles[key] and ESP_COLORS[key] or Color3.fromRGB(40, 40, 45)
        btn.TextColor3 = espToggles[key] and Color3.fromRGB(0,0,0) or Color3.fromRGB(255, 255, 255)
        if not espToggles[key] then
            for p, d in pairs(tracked) do
                if d.cat == key then d.hl:Destroy(); d.bb:Destroy(); tracked[p] = nil end
            end
        end
    end)
end

