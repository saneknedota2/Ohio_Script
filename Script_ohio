local espFolder = Instance.new("Folder", Workspace)

local function createVisual(part, color, category)
    if tracked[part] then return end
    if not part:IsA("Model") and not part:IsA("BasePart") and not part:IsA("Tool") then return end

    -- ЛИМИТ НА ОБЪЕКТЫ
    local count = 0
    for _ in pairs(tracked) do count = count + 1 end
    if count > 50 then return end

    local hl = Instance.new("Highlight")
    hl.FillColor = color
    hl.FillTransparency = 0.5
    hl.OutlineColor = color
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = espFolder
    
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 150, 0, 20)
    bb.AlwaysOnTop = true
    bb.Parent = espFolder
    
    -- ИСПРАВЛЕНИЕ ЗЕЛЕНЫХ КВАДРАТОВ: Ищем настоящий ствол внутри модели
    local targetPart = part
    if part:IsA("Model") or part:IsA("Tool") then
        local handle = part:FindFirstChild("Handle") 
        local mesh = part:FindFirstChildWhichIsA("MeshPart")
        if handle then targetPart = handle elseif mesh then targetPart = mesh else targetPart = part.PrimaryPart end
    end

    if targetPart then
        hl.Adornee = targetPart
        bb.Adornee = targetPart
    else
        hl.Adornee = part
        bb.Adornee = part
    end

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = color
    lbl.Text = part.Name
    lbl.Parent = bb
    
    tracked[part] = {hl=hl, bb=bb, cat=category}
end

local function isItem(obj, category)
    local n = obj.Name:lower()
    
    -- ИГНОРИРУЕМ ИГРОКОВ
    if Players:GetPlayerFromCharacter(obj) or (obj.Parent and Players:GetPlayerFromCharacter(obj.Parent)) then return false end

    -- ИГНОРИРУЕМ МУСОР
    if n:find("fake") or n:find("glass") or n:find("grass") or n:find("wall") or n:find("floor") or n:find("baseplate") or n:find("building") or n:find("sign") or n:find("mesh") or n:find("material") or n:find("tutorial") then return false end

    -- ИГНОРИРУЕМ ЗЕЛЕНЫЕ КВАДРАТЫ (Hitbox, Part, Spawn)
    if n == "part" or n == "hitbox" or n == "spawn" or n == "base" or n == "block" then return false end

    -- ИГНОРИРУЕМ ШКАФЫ
    local isLocker = n:find("locker") or n:find("case") or n:find("cabinet") or n:find("drawer") or n:find("counter") or n:find("crate")

    local function hasPrice(o)
        return o:FindFirstChild("Price") or o:FindFirstChild("Cost") or o:FindFirstChildWhichIsA("NumberValue")
    end
    local objHasPrice = hasPrice(obj) or (obj.Parent and hasPrice(obj.Parent))
    local canPickup = obj:IsA("Tool") or obj:FindFirstChildWhichIsA("ClickDetector", true) or obj:FindFirstChildWhichIsA("ProximityPrompt", true)

    if category == "ShopWeapon" then
        return (n:find("gun") or n:find("ak") or n:find("m4") or n:find("pistol") or n:find("shotgun") or n:find("rifle") or n:find("weapon") or n:find("deagle") or n:find("glock") or n:find("m1911") or n:find("сайга")) and not isLocker and objHasPrice
    elseif category == "DropWeapon" then
        return (n:find("gun") or n:find("ak") or n:find("m4") or n:find("pistol") or n:find("shotgun") or n:find("rifle") or n:find("weapon")) and not isLocker and canPickup and not objHasPrice
    elseif category == "Armor" then
        return n:find("armor") or n:find("vest") or n:find("helmet")
    elseif category == "Money" then
        return (n:find("atm") or n:find("vault") or n:find("safe") or n:find("bankcash") or n == "cash" or n:find("money")) and not n:find("register")
    elseif category == "Food" then
        return (n:find("food") or n:find("medkit") or n:find("bandage") or n:find("apple") or n:find("burger")) and canPickup
    elseif category == "BlueCard" then
        return canPickup and n:find("blue") and (n:find("card") or n:find("key"))
    elseif category == "RedCard" then
        return canPickup and n:find("red") and (n:find("card") or n:find("key"))
    elseif category == "AllCards" then
        return canPickup and (n:find("card") or n:find("key"))
    end
    return false
end

