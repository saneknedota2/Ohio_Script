local function showNotification(text, isCard)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 300, 0, 45)
    frame.Position = UDim2.new(0.5, -150, 0.85, 50)
    frame.BackgroundColor3 = isCard and Color3.fromRGB(50, 20, 60) or Color3.fromRGB(20, 30, 40)
    frame.BorderSizePixel = 0
    frame.Parent = notifGui
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)
    
    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = isCard and Color3.fromRGB(255, 0, 255) or Color3.fromRGB(0, 150, 255)
    stroke.Thickness = 2

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -10, 1, 0)
    lbl.Position = UDim2.new(0, 5, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 14
    lbl.TextWrapped = true
    lbl.Parent = frame

    local tweenIn = TweenService:Create(frame, TweenInfo.new(0.3, Enum.EasingStyle.Back), {Position = UDim2.new(0.5, -150, 0.85, -20)})
    tweenIn:Play()

    task.delay(3, function()
        local tweenOut = TweenService:Create(frame, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {Position = UDim2.new(0.5, -150, 0.85, 50)})
        tweenOut:Play()
        tweenOut.Completed:Connect(function() frame:Destroy() end)
    end)
end

