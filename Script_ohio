local function createButton(text, mode, color, yPos)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 30)
    btn.Position = UDim2.new(0, 10, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 13
    btn.Parent = mainFrame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    
    btn.MouseButton1Click:Connect(function()
        if mode == "AutoFarmBank" then
            autoFarmBank = not autoFarmBank
            if autoFarmBank then tpFarm = false end
            btn.BackgroundColor3 = autoFarmBank and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(30, 30, 40)
            btn.Text = autoFarmBank and "ФАРМ РЯДОМ: ВКЛ" or "Авто-Фарм (рядом)"
        elseif mode == "TPFarm" then
            tpFarm = not tpFarm
            if tpFarm then autoFarmBank = false end
            btn.BackgroundColor3 = tpFarm and Color3.fromRGB(0, 255, 255) or Color3.fromRGB(30, 30, 40)
            btn.Text = tpFarm and "ТП-ФАРМ (AFK): ВКЛ" or "ТП-Фарм (AFK)"
        else
            currentMode = mode
            for p, d in pairs(tracked) do d.hl:Destroy(); d.bb:Destroy(); tracked[p] = nil end
            for _, child in ipairs(mainFrame:GetChildren()) do
                if child:IsA("TextButton") and child ~= btn and not child.Text:find("ФАРМ") then
                    child.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
                end
            end
            if mode ~= "OFF" then btn.BackgroundColor3 = color end
        end
    end)
end

